#!/usr/bin/env bash
# proxdump — encrypted backup of Proxmox VE VMs/containers to cloud storage
# (Microsoft OneDrive, Google Drive, Dropbox, S3-compatible storage, SFTP)
#
# Pipeline: vzdump (temporary local archive) -> rclone crypt -> destination(s)
# Interface: whiptail menus, or non-interactive subcommands (cron).
#
# SPDX-License-Identifier: AGPL-3.0-or-later — see LICENSE.

set -u
set -o pipefail

VERSION="1.0.2"
TITLE="proxdump $VERSION"

CONF_DIR="${PROXDUMP_CONF_DIR:-/etc/proxdump}"
CONF_FILE="$CONF_DIR/config"
LOG_FILE="${PROXDUMP_LOG:-/var/log/proxdump.log}"
LOCK_FILE="${PROXDUMP_LOCK:-/run/lock/proxdump.lock}"
CRON_FILE="${PROXDUMP_CRON:-/etc/cron.d/proxdump}"
export RCLONE_CONFIG="$CONF_DIR/rclone.conf"

# --- Defaults (overridden by $CONF_FILE) ------------------------------------
REMOTE_DIR="pve-backups/$(hostname -s)"   # folder on each destination
STAGING_DIR="/var/lib/vz/dump"    # local staging folder (vzdump archives)
KEEP_DEFAULT=3                    # versions kept per guest (0 = all)
VZDUMP_MODE="snapshot"            # snapshot | suspend | stop
COMPRESS="zstd"                   # zstd | gzip | lzo | 0
BWLIMIT=""                        # rclone rate limit (e.g. 10M), empty = none
VERIFY=1                          # verify checksums after upload
UI_LANG=""                        # interface language; empty = that of the system
UI_STYLE="native"                 # native (dialogs drawn by proxdump) | whiptail
UI_THEME="auto"                   # colours of the native interface
UI_MOUSE=1                        # mouse in the native interface
declare -A KEEP_BY_ID=()          # per-guest retention: KEEP_BY_ID[100]=5

CLEANUP_DIRS=()

# --- Languages ---------------------------------------------------------------
# English is the source language: every message is written in English in
# this file, and looked up in the catalogue of the selected language
# ($LANG_DIR/<code>.sh, one "_m 'English' 'translation'" line per message).
# A message without translation is displayed in English. In a message, {1},
# {2}… stand for the arguments.
LANG_CODES=(en fr es de zh ru)
declare -A LANG_NAMES=([en]="English" [fr]="Français" [es]="Español"
    [de]="Deutsch" [zh]="中文" [ru]="Русский")
LANG_DIR="${PROXDUMP_LANG_DIR:-}"
if [[ -z $LANG_DIR ]]; then
    LANG_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lang"
    [[ -d $LANG_DIR ]] || LANG_DIR=/usr/local/share/proxdump/lang
    [[ -d $LANG_DIR ]] || LANG_DIR=/usr/share/proxdump/lang
fi
LIB_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib"
[[ -d $LIB_DIR ]] || LIB_DIR=/usr/local/share/proxdump/lib
[[ -d $LIB_DIR ]] || LIB_DIR=/usr/share/proxdump/lib
CUR_LANG=en
declare -A T=()
_m() { T[$1]=$2; }

# Accented, Cyrillic and Chinese characters need a UTF-8 terminal
UTF8_FORCED=0
if [[ $(locale charmap 2>/dev/null) != UTF-8 ]]; then
    export LC_ALL=C.UTF-8
    # shellcheck disable=SC2034  # read by lib/tui.sh
    UTF8_FORCED=1
fi

t() { # message, arguments
    local s=$1 i=1 a
    [[ -n $s && -n ${T[$s]:-} ]] && s=${T[$s]}
    shift
    for a; do
        s=${s//"{$i}"/"$a"}
        i=$((i + 1))
    done
    printf '%s\n' "$s"
}

# Selects the language: PROXDUMP_LANG, else the configuration, else the system
load_language() {
    local code=${PROXDUMP_LANG:-$UI_LANG}
    if [[ -z $code ]]; then
        code=${LC_MESSAGES:-${LANG:-en}}
        code=${code%%[_.@]*}
    fi
    T=()
    CUR_LANG=en
    if [[ $code != en && -r $LANG_DIR/$code.sh ]]; then
        # shellcheck disable=SC1090
        source "$LANG_DIR/$code.sh"
        CUR_LANG=$code
    fi
    BTN_OK=(--ok-button "$(t "Ok")")
    BTN_CANCEL=(--cancel-button "$(t "Cancel")")
    BTN_YN=(--yes-button "$(t "Yes")" --no-button "$(t "No")")
}
BTN_OK=() BTN_CANCEL=() BTN_YN=()
UI=0 # 1 while an operation started from the menus runs behind a gauge

# --- Destinations ------------------------------------------------------------
# A destination is an rclone remote named after its id, with a "crypt" remote
# '<id>-crypt' layered on top. Supporting another repository starts here.
DEST_IDS=(onedrive gdrive dropbox s3 sftp)
declare -A DEST_NAMES=([onedrive]="OneDrive" [gdrive]="Google Drive"
    [dropbox]="Dropbox" [s3]="S3 storage" [sftp]="SFTP server")
declare -A DEST_TYPES=([onedrive]=onedrive [gdrive]=drive
    [dropbox]=dropbox [s3]=s3 [sftp]=sftp) # rclone backend
# destinations authorized in a web browser, and who grants the authorization
declare -A DEST_VENDORS=([onedrive]=Microsoft [gdrive]=Google [dropbox]=Dropbox)
# destinations whose token lapses when it stays unused, and after how long
declare -A DEST_TOKEN_LIFE=([onedrive]="90 days" [gdrive]="6 months")
# i18n: "S3 storage" "SFTP server" "90 days" "6 months"
# where REMOTE_DIR lives on destinations that have no root of their own:
# the bucket (s3) or a folder of the server (sftp). Saved in $CONF_FILE.
declare -A DEST_ROOT=()
DESTS=() # destinations of the backup being run

# Makes a destination the current one: every function below that reads,
# writes or deletes remote files works on it.
use_dest() {
    DEST=$1
    BASE_REMOTE=$1
    CRYPT_REMOTE="$1-crypt"
    DEST_NAME=$(t "${DEST_NAMES[$1]:-$1}")
}

# 'remote:path' of the folder that holds the backups of a destination
dest_base() { # id
    local root=${DEST_ROOT[$1]:-}
    [[ -n $root ]] && root="${root%/}/"
    echo "$1:$root$REMOTE_DIR"
}

# --- Helpers -----------------------------------------------------------------

log() {
    local line
    line="$(date '+%F %T') $*"
    echo "$line" >>"$LOG_FILE" 2>/dev/null
    echo "$*"
    # from the menus, each message also becomes the step shown in the gauge
    ((UI)) && [[ $* != ERROR* ]] && gauge_step "$*"
    return 0
}

die() {
    log "ERROR: $*" >&2
    exit 1
}

cleanup() {
    local d
    for d in "${CLEANUP_DIRS[@]:-}"; do
        [[ -n $d && -d $d ]] && rm -rf -- "$d"
    done
    declare -F tui_leave >/dev/null && tui_leave
    kbd_restore
    return 0
}
trap cleanup EXIT
trap 'ui_abort; echo; log "$(t "Interrupted.")"; exit 130' INT TERM

load_config() {
    # shellcheck disable=SC1090
    [[ -r $CONF_FILE ]] && source "$CONF_FILE"
    # earlier versions saved the remote names; they now follow the destination
    load_language
    use_dest onedrive
    return 0
}

save_config() {
    local v id
    install -d -m 700 "$CONF_DIR"
    {
        echo "# proxdump — generated automatically, contains no secrets"
        for v in REMOTE_DIR STAGING_DIR KEEP_DEFAULT \
                 VZDUMP_MODE COMPRESS BWLIMIT VERIFY UI_LANG \
                 UI_STYLE UI_THEME UI_MOUSE; do
            printf '%s=%q\n' "$v" "${!v}"
        done
        for id in "${!KEEP_BY_ID[@]}"; do
            printf 'KEEP_BY_ID[%s]=%q\n' "$id" "${KEEP_BY_ID[$id]}"
        done
        for id in "${!DEST_ROOT[@]}"; do
            printf 'DEST_ROOT[%s]=%q\n' "$id" "${DEST_ROOT[$id]}"
        done
    } >"$CONF_FILE.tmp"
    chmod 600 "$CONF_FILE.tmp"
    mv "$CONF_FILE.tmp" "$CONF_FILE"
}

check_deps() {
    local missing=() c
    for c in whiptail rclone jq vzdump pvesh qmrestore pct flock numfmt; do
        command -v "$c" >/dev/null || missing+=("$c")
    done
    ((${#missing[@]} == 0)) || die "$(t "missing commands: {1} (run install.sh)" "${missing[*]}")"
}

LOCK_WAIT=0 # seconds to wait for a running operation (0 = give up at once)

acquire_lock() {
    exec 9>"$LOCK_FILE"
    flock -n 9 && return 0
    if ((LOCK_WAIT > 0)); then
        log "$(t "Another proxdump operation is in progress; waiting for it to finish (up to {1})." "$(human_duration "$LOCK_WAIT")")"
        flock -w "$LOCK_WAIT" 9 && return 0
    fi
    log "$(t "Another proxdump operation is already in progress.")"
    return 1
}

release_lock() {
    flock -u 9 2>/dev/null
    exec 9>&-
}

has_remote() {
    rclone listremotes 2>/dev/null | grep -qxF "$1:"
}

is_ready() { # the current destination
    has_remote "$BASE_REMOTE" && has_remote "$CRYPT_REMOTE"
}

# Destinations that are connected and usable. TSV: id, label
dest_list() {
    local id remotes
    remotes=$(rclone listremotes 2>/dev/null)
    for id in "${DEST_IDS[@]}"; do
        grep -qxF "$id:" <<<"$remotes" && grep -qxF "$id-crypt:" <<<"$remotes" &&
            printf '%s\t%s\n' "$id" "$(t "${DEST_NAMES[$id]}")"
    done
    # the status of the last test must not become that of the function:
    # callers read it through pipelines, under 'pipefail'
    return 0
}

dest_ready() { # id
    dest_list | cut -f1 | grep -qxF -- "$1"
}

# 'onedrive,gdrive' -> 'OneDrive and Google Drive'; empty = whatever is configured
dest_label() {
    local id name out=""
    [[ -n $1 ]] || { t "every configured destination"; return; }
    for id in ${1//,/ }; do
        name=$(t "${DEST_NAMES[$id]:-$id}")
        if [[ -n $out ]]; then out=$(t "{1} and {2}" "$out" "$name"); else out=$name; fi
    done
    echo "$out"
}

# Fills DESTS from a comma-separated list (empty = every configured
# destination); fails with a message if one of them cannot be used.
set_dests() {
    local id
    DESTS=()
    if [[ -z $1 ]]; then
        mapfile -t DESTS < <(dest_list | cut -f1)
        ((${#DESTS[@]})) || { t "no destination is configured"; return 1; }
        return 0
    fi
    for id in ${1//,/ }; do
        dest_ready "$id" || { t "destination '{1}' is unknown or not configured" "$id"; return 1; }
        DESTS+=("$id")
    done
}

human_size() {
    numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "$1"
}

human_ts() { # 2026_10_12-18_00_00 -> 2026-10-12 18:00
    local t=$1
    echo "${t:0:4}-${t:5:2}-${t:8:2} ${t:11:2}:${t:14:2}"
}

keep_for() {
    echo "${KEEP_BY_ID[$1]:-$KEEP_DEFAULT}"
}

# --- Progress display --------------------------------------------------------

human_duration() { # seconds -> 1h02m, 3m04s, 5s
    local s=${1%.*}
    [[ $s =~ ^[0-9]+$ ]] || { echo "-"; return; }
    if ((s >= 3600)); then
        printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
    elif ((s >= 60)); then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

# While an operation runs from the menus, its progress is shown by a whiptail
# gauge fed through fd 8: a heading (G_HEAD), the current step (G_STEP) and
# a line of details.
gauge() { # percentage, details
    printf 'XXX\n%s\n%s\n\n%s\n%s\nXXX\n' "$1" "$G_HEAD" "$G_STEP" "$2" 2>/dev/null >&8
}
gauge_step() {
    G_STEP=${1#=== }
    G_STEP=${G_STEP% ===}
    gauge 0 ""
}

# Redraws a one-line progress bar in place: [#####-----]  42%  details
progress_bar() { # percentage, details
    local pct=$1 cols width fill line
    ((pct > 100)) && pct=100
    if ((UI)); then
        gauge "$pct" "$2"
        return
    fi
    cols=$(tput cols 2>/dev/null || echo 80)
    width=$((cols - 60)); ((width > 40)) && width=40; ((width < 10)) && width=10
    fill=$((pct * width / 100))
    printf -v line '[%s%s] %3d%%  %s' "$(printf '%*s' "$fill" '' | tr ' ' '#')" \
        "$(printf '%*s' $((width - fill)) '' | tr ' ' '-')" "$pct" "$2"
    printf '\r\033[K%s' "${line:0:cols-1}"
}

# Same line, for steps that report no percentage
progress_note() {
    if ((UI)); then gauge 0 "$1"; else printf '\r\033[K  %s' "$1"; fi
}
progress_end() { ((UI)) || printf '\r\033[K'; }

# Runs a command that reports nothing while it works; behind a gauge, the
# time elapsed is shown meanwhile.
run_quiet() { # command…
    local pid start=$SECONDS
    if ((!UI)); then
        "$@"
        return
    fi
    "$@" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        gauge 0 "$(t "{1} elapsed" "$(human_duration $((SECONDS - start)))")"
        sleep 1
    done
    wait "$pid"
}

# Runs a Proxmox command (vzdump, qmrestore, pct restore) and logs its output.
# On a terminal, its percentage lines become a progress bar; while it reports
# none (container archives), the size written so far to the given folder is shown.
run_logged() { # folder to watch (or ""), command…
    local dir=$1 line part="" rc bar=0 pct=0 start=$SECONDS
    local re_dump='^INFO: +([0-9]+)% \(([^)]*)\) in ([^,]*)(, read: ([^,]*))?'
    local re_restore='^progress ([0-9]+)% \(read ([0-9]+) bytes, duration ([0-9]+) sec\)'
    shift
    if ((!UI)) && [[ ! -t 1 ]]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"
        return "${PIPESTATUS[0]}"
    fi
    "$@" 2>&1 | while :; do
        IFS= read -r -t 2 line
        rc=$?
        if ((rc > 128)); then # nothing new for 2 s
            part+=$line
            if ((!bar)) && [[ -n $dir ]]; then
                progress_note "$(t "In progress: {1} written, {2} elapsed" "$(human_size "$(du -sb "$dir" 2>/dev/null | cut -f1)")" "$(human_duration $((SECONDS - start)))")"
            fi
            continue
        fi
        line=$part$line
        part=""
        ((rc != 0)) && [[ -z $line ]] && break
        echo "$line" >>"$LOG_FILE"
        if [[ $line =~ $re_dump ]]; then
            bar=1 pct=${BASH_REMATCH[1]}
            progress_bar "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}  ${BASH_REMATCH[5]}  ${BASH_REMATCH[3]}"
        elif [[ $line =~ $re_restore ]]; then
            bar=1 pct=${BASH_REMATCH[1]}
            progress_bar "${BASH_REMATCH[1]}" "$(human_size "${BASH_REMATCH[2]}") read  $(human_duration "${BASH_REMATCH[3]}")"
        else
            bar=0
            if ((UI)); then
                # the full output is in the log; errors also go to the summary
                gauge "$pct" "${line#INFO: }"
                [[ $line == *ERROR* || $line == *rror:* ]] && echo "$line"
            else
                progress_end
                echo "$line"
            fi
        fi
        ((rc != 0)) && break
    done
    rc=${PIPESTATUS[0]}
    progress_end
    return "$rc"
}

# rclone copy, with a progress bar on a terminal and sparse statistics under
# cron. On a terminal rclone logs in JSON: the statistics feed the bar, the
# other messages go to the log file.
rclone_copy() { # source, destination
    local opts=(--retries 5 --low-level-retries 20) kind a b c d rc
    [[ -n $BWLIMIT ]] && opts+=(--bwlimit "$BWLIMIT")
    if ((!UI)) && [[ ! -t 1 ]]; then
        rclone copy "$1" "$2" "${opts[@]}" --log-file "$LOG_FILE" --log-level INFO \
            --stats 5m --stats-one-line
        return
    fi
    rclone copy "$1" "$2" "${opts[@]}" --log-level INFO --use-json-log --stats 1s 2>&1 >/dev/null |
        jq --unbuffered -rR '
            (fromjson? // {msg: .}) as $l
            | if $l.stats then
                $l.stats | ["S", .bytes, .totalBytes, (.speed // 0 | floor), (.eta // "")]
              else
                ["L", ($l.level // "notice"), ($l.msg | gsub("[\\n\\t]"; " ")), ($l.object // ""), ""]
              end
            | map(tostring) | join("\u001f")' |
        while IFS=$'\x1f' read -r kind a b c d; do
            if [[ $kind == S ]]; then
                ((b > 0)) && progress_bar $((a * 100 / b)) \
                    "$(t "{1} / {2}  {3}/s  remaining: {4}" "$(human_size "$a")" "$(human_size "$b")" "$(human_size "$c")" "$(human_duration "$d")")"
            else
                echo "$(date '+%F %T') rclone $a: $b${c:+ ($c)}" >>"$LOG_FILE"
                if [[ $a == error ]]; then
                    progress_end
                    echo "rclone: $b${c:+ ($c)}"
                fi
            fi
        done
    rc=${PIPESTATUS[0]}
    progress_end
    return "$rc"
}

# --- Inventory ---------------------------------------------------------------

# Guests on the local node. TSV: vmid, type (qemu|lxc), name, status
# Read straight from /etc/pve: an order of magnitude faster than pvesh, which
# matters because the menus call this on every screen.
guest_list() {
    local dir f id type key name status
    dir="/etc/pve/nodes/$(hostname -s)"
    for f in "$dir"/qemu-server/*.conf "$dir"/lxc/*.conf; do
        [[ -f $f ]] || continue
        id=${f##*/}
        id=${id%.conf}
        status=stopped
        if [[ $f == */qemu-server/* ]]; then
            type=qemu key=name
            kill -0 "$(cat "/run/qemu-server/$id.pid" 2>/dev/null)" 2>/dev/null && status=running
        else
            type=lxc key=hostname
            [[ -d /sys/fs/cgroup/lxc/$id ]] && status=running
        fi
        # the first section only: what follows describes snapshots
        name=$(awk -v k="$key:" '/^\[/ { exit } $1 == k { print $2; exit }' "$f")
        printf '%s\t%s\t%s\t%s\n' "$id" "$type" "${name:--}" "$status"
    done | sort -n
}

# Backups stored on the current destination, newest first for each guest.
# TSV: vmid, timestamp, type, name, size (bytes), path
remote_list() {
    local json err
    err=$(mktemp)
    if ! json=$(rclone lsjson -R --files-only "$CRYPT_REMOTE:" 2>"$err"); then
        # folder not created yet = no backups, not an error
        if grep -q "directory not found" "$err"; then
            rm -f "$err"
            return 0
        fi
        cat "$err" >>"$LOG_FILE"
        rm -f "$err"
        return 1
    fi
    rm -f "$err"
    jq -r '
        .[]
        | select(.Name | test("^vzdump-(qemu|lxc)-[0-9]+-[0-9_]+-[0-9_]+\\.(vma|tar)(\\.(zst|gz|lzo))?$"))
        | (.Name | capture("^vzdump-(?<t>qemu|lxc)-(?<id>[0-9]+)-(?<ts>[0-9_]+-[0-9_]+)\\.")) as $m
        | [ $m.id, $m.ts, $m.t,
            (.Path | split("/") | if length > 1 then (.[0] | sub("^[0-9]+_"; "")) else "-" end),
            (.Size|tostring), .Path ]
        | @tsv' <<<"$json" | sort -t$'\t' -k1,1n -k2,2r
}

# Deletes a backup and its companion files (.log)
delete_backup() { # archive path on the remote
    local path=$1 dir file prefix
    dir=$(dirname "$path")
    [[ $dir == "." ]] && dir=""
    file=$(basename "$path")
    [[ $file =~ ^(vzdump-(qemu|lxc)-[0-9]+-[0-9_]+-[0-9_]+)\. ]] || return 1
    prefix=${BASH_REMATCH[1]}
    rclone delete "$CRYPT_REMOTE:$dir" --include "/$prefix.*" \
        --log-file "$LOG_FILE" --log-level INFO </dev/null
}

# Applies retention (to every guest, or to a single one if a vmid is given)
prune_remote() {
    local only=${1:-} id ts type name size path keep prev="" n=0 deleted=0
    while IFS=$'\t' read -r id ts type name size path; do
        [[ -n $only && $id != "$only" ]] && continue
        if [[ $id != "$prev" ]]; then
            prev=$id
            n=0
        fi
        n=$((n + 1))
        keep=$(keep_for "$id")
        ((keep > 0 && n > keep)) || continue
        log "$(t "Retention ({1} version(s) for {2}): deleting {3}" "$keep" "$id" "$path")"
        if delete_backup "$path"; then
            deleted=$((deleted + 1))
        else
            log "ERROR: $(t "could not delete {1}" "$path")"
        fi
    done < <(remote_list)
    ((deleted > 0)) && rclone rmdirs "$CRYPT_REMOTE:" --leave-root 2>>"$LOG_FILE"
    # after a backup, only worth a line when something was deleted
    [[ -n $only ]] && ((deleted == 0)) || log "$(t "Retention: {1} backup(s) deleted." "$deleted")"
}

# --- Backup ------------------------------------------------------------------

# Compares an uploaded folder with its local source. Checksums are used
# whenever the destination provides them; an SFTP server without checksum
# commands only allows the sizes to be compared.
verify_upload() { # local folder, crypt path
    if rclone backend features "$BASE_REMOTE:" 2>/dev/null | jq -e '.Hashes | length > 0' >/dev/null; then
        log "$(t "Verifying checksums (re-reads the local archive)…")"
        run_quiet rclone cryptcheck "$1" "$2" --one-way --log-file "$LOG_FILE" --log-level NOTICE
    else
        log "$(t "Verifying sizes ({1} provides no checksums)…" "$DEST_NAME")"
        run_quiet rclone check "$1" "$2" --one-way --size-only --log-file "$LOG_FILE" --log-level NOTICE
    fi
}

backup_guest() { # vmid type name
    local id=$1 type=$2 name=$3 tmp archive safe dest rc d
    safe=$(tr -c 'A-Za-z0-9.-' '-' <<<"$name" | sed 's/-*$//')
    dest="${id}_${safe:-guest}"

    [[ -d $STAGING_DIR && -w $STAGING_DIR ]] ||
        { log "ERROR: $(t "staging folder {1} is not usable" "$STAGING_DIR")"; return 1; }
    tmp=$(mktemp -d "$STAGING_DIR/proxdump.XXXXXX") || return 1
    CLEANUP_DIRS+=("$tmp")
    # an unprivileged container is archived by a shifted uid, which must be
    # able to traverse the folder (without being able to list its contents)
    chmod 711 "$tmp"

    log "=== $(t "Backing up {1} {2} ({3})" "$type" "$id" "$name") ==="
    ((UI)) && gauge_step "$(t "Creating the archive (vzdump, {1} mode)…" "$VZDUMP_MODE")"
    run_logged "$tmp" vzdump "$id" --dumpdir "$tmp" --mode "$VZDUMP_MODE" --compress "$COMPRESS"
    rc=$?
    archive=$(find "$tmp" -maxdepth 1 -type f \( -name 'vzdump-*.vma*' -o -name 'vzdump-*.tar*' \) | head -n1)
    if ((rc != 0)) || [[ -z $archive ]]; then
        log "ERROR: $(t "vzdump failed for {1} (exit code {2})" "$id" "$rc")"
        rm -rf -- "$tmp"
        return 1
    fi

    # one archive, uploaded to each destination in turn
    for d in "${DESTS[@]}"; do
        use_dest "$d"
        log "$(t "Encrypted upload of {1} ({2}) to {3}…" "$(basename "$archive")" "$(human_size "$(stat -c %s "$archive")")" "$DEST_NAME")"
        if ! rclone_copy "$tmp" "$CRYPT_REMOTE:$dest"; then
            log "ERROR: $(t "upload to {1} failed for {2}" "$DEST_NAME" "$id")"
            rc=1
            continue
        fi
        if [[ $VERIFY == 1 ]]; then
            if ! verify_upload "$tmp" "$CRYPT_REMOTE:$dest"; then
                log "ERROR: $(t "verification failed for {1} — the copy on {2} cannot be trusted" "$id" "$DEST_NAME")"
                rc=1
                continue
            fi
        fi
        log "$(t "Backup of {1} to {2} complete." "$id" "$DEST_NAME")"
        prune_remote "$id"
    done
    rm -rf -- "$tmp"
    return "$rc"
}

# Backs up a list of guests to the destinations in DESTS;
# exit status = number of failures
backup_guests() { # vmid…
    local id type name status failed=0 found guests n=0
    ((${#DESTS[@]})) || { log "ERROR: $(t "no destination is configured")"; return 1; }
    for id in "${DESTS[@]}"; do
        dest_ready "$id" || { log "ERROR: $(t "destination '{1}' is not configured" "$id")"; return 1; }
    done
    acquire_lock || return 1
    guests=$(guest_list)
    for id in "$@"; do
        found=0
        while IFS=$'\t' read -r gid type name status; do
            if [[ $gid == "$id" ]]; then
                found=1
                n=$((n + 1))
                G_HEAD=$(t "Backup {1} of {2}: {3} {4} ({5})" "$n" "$#" "$type" "$id" "$name")
                backup_guest "$id" "$type" "$name" </dev/null || failed=$((failed + 1))
                break
            fi
        done <<<"$guests"
        ((found)) || { log "ERROR: $(t "guest {1} not found on this node" "$id")"; failed=$((failed + 1)); }
    done
    release_lock
    OP_DONE=$(t "Done: {1}/{2} backup(s) succeeded." "$(($# - failed))" "$#")
    log "$OP_DONE"
    return "$failed"
}

# --- whiptail interface ------------------------------------------------------

# Keys typed while an operation runs are neither echoed nor handed to the
# next dialog: the menus keep the echo off, and each dialog first discards
# what is waiting. Only the plain terminal (screen) echoes again.
TTY_STTY=""
kbd_hush() { stty -echo -icanon </dev/tty 2>/dev/null; return 0; }
kbd_drain() { while read -r -s -n 1 -t 0.01 _ </dev/tty 2>/dev/null; do :; done; return 0; }
kbd_restore() { [[ -n $TTY_STTY ]] && stty "$TTY_STTY" </dev/tty 2>/dev/null; return 0; }

dims() {
    local rows cols
    kbd_drain
    kbd_hush
    read -r rows cols < <(stty size </dev/tty 2>/dev/null || echo "24 80")
    H=$((rows - 4)); ((H > 30)) && H=30; ((H < 16)) && H=16
    W=$((cols - 6)); ((W > 100)) && W=100; ((W < 60)) && W=60
    LH=$((H - 9))
}

# Dialogs are sized to their contents instead of filling the screen
text_lines() { # text -> TL, the number of lines it takes at width W
    local text=${1//\\n/$'\n'} line wide LC_COLLATE=C
    TL=0
    while IFS= read -r line; do
        # characters beyond U+2E7F (Chinese, full-width forms) take two columns
        wide=${line//[$'\u0001'-$'\u2e7f']/}
        TL=$((TL + 1 + (${#line} + ${#wide}) / (W - 4)))
    done <<<"$text"
}
box_dims() { # text, extra lines (input field)
    dims
    text_lines "$1"
    ((TL + 6 + ${2:-0} < H)) && H=$((TL + 6 + ${2:-0}))
}
list_dims() { # text, number of entries
    dims
    text_lines "$1"
    LH=$2
    ((LH > H - TL - 7)) && LH=$((H - TL - 7))
    ((LH < 3)) && LH=3
    H=$((LH + TL + 7))
}

msg() { box_dims "$1"; whiptail --title "$TITLE" "${BTN_OK[@]}" --msgbox "$1" "$H" "$W"; }
confirm() { box_dims "$1"; whiptail --title "$TITLE" "${BTN_YN[@]}" --yesno "$1" "$H" "$W"; }
confirm_no() { box_dims "$1"; whiptail --title "$TITLE" "${BTN_YN[@]}" --defaultno --yesno "$1" "$H" "$W"; }
input() { box_dims "$1" 2; whiptail --title "$TITLE" "${BTN_OK[@]}" "${BTN_CANCEL[@]}" --inputbox "$1" "$H" "$W" "${2:-}" 3>&1 1>&2 2>&3; }
password() { box_dims "$1" 2; whiptail --title "$TITLE" "${BTN_OK[@]}" "${BTN_CANCEL[@]}" --passwordbox "$1" "$H" "$W" 3>&1 1>&2 2>&3; }
# A text that fits is closed with Enter; a scrolling one keeps the keyboard
# focus on the text, hence the reminder in its title.
textbox() { # title, file
    local title=$1 opts=()
    dims
    if (($(wc -l <"$2") + 6 <= H)); then
        H=$(($(wc -l <"$2") + 6))
    else
        opts=(--scrolltext)
        title+=" $(t "(Tab, then Enter, to close)")"
    fi
    whiptail --title "$title" "${BTN_OK[@]}" "${opts[@]}" --textbox "$2" "$H" "$W"
}
# The second button reads "Cancel" unless CANCEL is set (Quit, Back)
menu() { # text, then tag/label pairs
    local text=$1
    shift
    list_dims "$text" $(($# / 2))
    # i18n: "Back" "Quit"
    whiptail --title "$TITLE" "${BTN_OK[@]}" --cancel-button "$(t "${CANCEL:-Cancel}")" \
        --menu "$text" "$H" "$W" "$LH" "$@" 3>&1 1>&2 2>&3
}
checklist() { # text, then tag/label/state triplets
    local text=$1
    shift
    list_dims "$text" $(($# / 3))
    whiptail --title "$TITLE" "${BTN_OK[@]}" "${BTN_CANCEL[@]}" --separate-output --checklist "$text" "$H" "$W" "$LH" "$@" 3>&1 1>&2 2>&3
}

# Runs an operation behind a gauge, then displays what it reported. The
# operation runs in this shell, its messages going to the summary.
ui_run() { # heading, command…
    local heading=$1 out rc start=$SECONDS
    shift
    out=$(mktemp)
    dims
    G_HEAD=$heading
    G_STEP=""
    OP_DONE=""
    gauge_start "$heading"
    UI=1
    "$@" >"$out" 2>&1
    rc=$?
    UI=0
    exec 8>&-
    wait "$GAUGE_PID" 2>/dev/null
    # the summary: the outcome first, then what was done and what failed,
    # without the steps (lines ending in '…') nor rclone's retries
    {
        echo "$OP_DONE"
        echo
        grep -vxF -- "$OP_DONE" "$out" | grep -vE '…$|^=== |^rclone: Attempt |^$' | awk '!seen[$0]++'
        echo
        t "Duration: {1}. The details are recorded in the log." "$(human_duration $((SECONDS - start)))"
    } | sed '1{/^$/d}' | cat -s >"$out.txt"
    summary_show "$heading" "$out.txt"
    rm -f "$out" "$out.txt"
    return "$rc"
}

# Opens the gauge that follows an operation; it is fed through fd 8.
# whiptail does not follow a change of the size of the terminal: a relay
# stands between the operation and the gauge, and starts a new gauge with
# the last text when the terminal is resized.
gauge_start() { # heading
    exec 8> >(_gauge_relay "$1" 2>/dev/null)
    GAUGE_PID=$!
}

_gauge_relay() { # heading; the protocol of 'whiptail --gauge' on its input
    local heading=$1 line part="" state=0 resized=0 rc w wpid l
    local -a block=() last=()
    trap 'resized=1' WINCH
    _start() {
        dims
        # the gauge keeps the height of its first text: four lines
        exec 7> >(exec whiptail --title "$TITLE" --gauge "$heading"$'\n \n \n ' 11 "$W" 0)
        wpid=$!
        # whiptail switches the terminal to raw mode, in which Ctrl-C is an
        # ordinary key: once it has started, interruptions are enabled again
        sleep 0.3
        stty isig intr '^C' </dev/tty 2>/dev/null
    }
    _send() {
        w=$((W - 4))
        # Chinese characters are two columns wide
        [[ $CUR_LANG == zh ]] && w=$((w / 2))
        {
            printf 'XXX\n%s\n' "${last[0]:-0}"
            for l in "${last[@]:1}"; do printf '%s\n' "${l:0:w}"; done
            printf 'XXX\n'
        } >&7
    }
    _start
    while :; do
        IFS= read -r -t 0.3 line
        rc=$?
        if ((resized)); then
            resized=0
            exec 7>&-
            wait "$wpid" 2>/dev/null
            _start
            ((${#last[@]})) && _send
        fi
        if ((rc)); then
            # a timeout may fall in the middle of a line: what was read is
            # kept and completed by the next read
            ((rc > 128)) && { part+=$line; continue; }
            break # end of the input: the operation is over
        fi
        line=$part$line
        part=""
        if [[ $line == XXX ]]; then
            if ((state)); then
                last=("${block[@]}")
                _send
                state=0
            else
                block=()
                state=1
            fi
        elif ((state)); then
            block+=("$line")
        fi
    done
    exec 7>&-
    wait "$wpid" 2>/dev/null
}

summary_show() { # heading, file
    local tmp
    dims
    text_lines "$(<"$2")"
    if ((TL + 6 <= H)); then
        whiptail --title "$TITLE — $1" "${BTN_OK[@]}" --msgbox "$(<"$2")" $((TL + 6)) "$W"
    else
        tmp=$(mktemp)
        fold -s -w $((W - 6)) "$2" >"$tmp"
        textbox "$TITLE — $1" "$tmp"
        rm -f "$tmp"
    fi
}

# Leaves the gauge cleanly when the operation is interrupted
ui_abort() {
    ((UI)) || return 0
    UI=0
    exec 8>&-
    kill "$GAUGE_PID" 2>/dev/null
    wait "$GAUGE_PID" 2>/dev/null
    # the operation runs with its input and output redirected: the terminal
    # is addressed directly
    stty sane </dev/tty 2>/dev/null
    clear >/dev/tty
    t "Interrupted." >/dev/tty
}

# Notice displayed while a dialog is being prepared. With its own terminal
# type whiptail would erase the box as soon as it is drawn.
busy() {
    dims
    TERM=ansi whiptail --title "$TITLE" --infobox "$1" 7 "$W"
}

# A few steps need the plain terminal, because text has to be copied from it
# or pasted into it: the authorization command and its token, an SSH key.
screen() { # heading
    kbd_restore
    kbd_drain
    clear
    printf '\033[1m%s — %s\033[0m\n\n' "$TITLE" "$1"
}

need_ready() {
    is_ready && return 0
    msg "$(t "A destination and the encryption must be configured before this function can be used.\n\nPlease complete the 'Configuration' menu first.")"
    return 1
}

# Makes one of the configured destinations the current one; the question
# (the argument, if any) is skipped when there is only one.
pick_dest() {
    local items=() id label
    while IFS=$'\t' read -r id label; do
        items+=("$id" "$label")
    done < <(dest_list)
    case ${#items[@]} in
    0) need_ready; return 1 ;;
    2) id=${items[0]} ;;
    *) id=$(menu "${1:-$(t "Select the destination:")}" "${items[@]}") || return 1 ;;
    esac
    use_dest "$id"
}

# Same, for a backup: several destinations may be selected (into DESTS)
pick_dests() {
    local items=() id label sel
    while IFS=$'\t' read -r id label; do
        items+=("$id" "$label" ON)
    done < <(dest_list)
    DESTS=()
    case ${#items[@]} in
    0) need_ready; return 1 ;;
    3) DESTS=("${items[0]}") ;;
    *)
        sel=$(checklist "$(t "Select the destinations of the backup (Space to select, Enter to confirm).\n\nThe archive is created once, then uploaded to each of them.")" "${items[@]}") || return 1
        [[ -n $sel ]] || { msg "$(t "No destination was selected.")"; return 1; }
        mapfile -t DESTS <<<"$sel"
        ;;
    esac
}

# Loads the remote listing into the BACKUPS array (one TSV line per entry)
load_backups() {
    local out
    busy "$(t "Reading the list of backups from {1}…" "$DEST_NAME")"
    if ! out=$(remote_list); then
        msg "$(t "The list of backups could not be read from {1}.\n\nPlease verify the connection (Configuration > Test the connections)." "$DEST_NAME")"
        return 1
    fi
    BACKUPS=()
    [[ -n $out ]] && mapfile -t BACKUPS <<<"$out"
    return 0
}

backup_label() { # TSV line -> readable label
    local id ts type name size path
    IFS=$'\t' read -r id ts type name size path <<<"$1"
    printf '%-5s %-4s %-18.18s %s %9s' "$id" "$type" "$name" "$(human_ts "$ts")" "$(human_size "$size")"
}

ui_backup() {
    pick_dests || return
    local items=() id type name status sel free
    while IFS=$'\t' read -r id type name status; do
        [[ -n $id ]] && items+=("$id" "$(printf '%-4s %-22.22s %s' "$type" "$name" "$status")" OFF)
    done < <(guest_list)
    ((${#items[@]})) || { msg "$(t "No virtual machine or container was found on this node.")"; return; }
    free=$(df -h --output=avail "$STAGING_DIR" 2>/dev/null | tail -n1 | tr -d ' ')
    sel=$(checklist "$(t "Select the guests to back up (Space to select, Enter to confirm).\n\nStaging folder: {1} ({2} free)\nMode: {3} — compression: {4} — default retention: {5}" "$STAGING_DIR" "${free:-?}" "$VZDUMP_MODE" "$COMPRESS" "$KEEP_DEFAULT")" "${items[@]}") || return
    [[ -n $sel ]] || return
    # shellcheck disable=SC2086
    ui_run "$(t "Backup")" backup_guests $sel
}

ui_list() {
    need_ready || return
    load_backups || return
    ((${#BACKUPS[@]})) || { msg "$(t "No backup was found on {1}." "$DEST_NAME")"; return; }
    local tmp line total=0 size
    tmp=$(mktemp)
    {
        printf '%-5s %-4s %-18s %-16s %9s\n' ID TYPE NAME DATE SIZE
        for line in "${BACKUPS[@]}"; do
            backup_label "$line"
            echo
            size=$(cut -f5 <<<"$line")
            total=$((total + size))
        done
        echo
        echo "$(t "{1} backup(s), {2} in total (size before encryption)" "${#BACKUPS[@]}" "$(human_size "$total")")"
    } >"$tmp"
    textbox "$(t "{1} — backups on {2}" "$TITLE" "$DEST_NAME")" "$tmp"
    rm -f "$tmp"
}

ui_delete() {
    need_ready || return
    load_backups || return
    ((${#BACKUPS[@]})) || { msg "$(t "No backup was found on {1}." "$DEST_NAME")"; return; }
    local items=() i sel n=0
    for i in "${!BACKUPS[@]}"; do
        items+=("$i" "$(backup_label "${BACKUPS[$i]}")" OFF)
    done
    sel=$(checklist "$(t "Select the backups to delete from {1} (Space to select, Enter to confirm)." "$DEST_NAME")" "${items[@]}") || return
    [[ -n $sel ]] || return
    n=$(wc -l <<<"$sel")
    confirm_no "$(t "Delete {1} backup(s) from {2}?\n\nDeleted files remain in the recycle bin of the account, still encrypted, until it is emptied." "$n" "$DEST_NAME")" || return
    # shellcheck disable=SC2086
    ui_run "$(t "Deletion on {1}" "$DEST_NAME")" op_delete $sel
}

op_delete() { # indexes in BACKUPS
    local i n=0
    acquire_lock || return 1
    for i; do
        log "$(t "Deleting {1}" "$(cut -f6 <<<"${BACKUPS[$i]}")")"
        delete_backup "$(cut -f6 <<<"${BACKUPS[$i]}")" || log "ERROR: $(t "deletion failed")"
        n=$((n + 1))
        gauge $((n * 100 / $#)) ""
    done
    rclone rmdirs "$CRYPT_REMOTE:" --leave-root 2>>"$LOG_FILE"
    release_lock
    OP_DONE=$(t "Done: {1} backup(s) processed." "$#")
    log "$OP_DONE"
}

valid_count() { [[ $1 =~ ^[0-9]+$ ]]; }

ui_retention() {
    local choice v id items type name status
    while :; do
        choice=$(CANCEL=Back menu "$(t "Number of versions retained for each guest.\nA value of 0 retains every version (no pruning).")" \
            D "$(t "Default value: {1}" "$KEEP_DEFAULT")" \
            G "$(t "Value per guest ({1} defined)" "${#KEEP_BY_ID[@]}")") || return
        case $choice in
        D)
            v=$(input "$(t "Number of versions retained by default (0 = retain every version):")" "$KEEP_DEFAULT") || continue
            valid_count "$v" || { msg "$(t "The value entered is not valid.")"; continue; }
            KEEP_DEFAULT=$v
            save_config
            ;;
        G)
            items=()
            while IFS=$'\t' read -r id type name status; do
                [[ -n $id ]] && items+=("$id" "$(printf '%-22.22s %s' "$name" "$(t "retains: {1}" "${KEEP_BY_ID[$id]:-$(t "default ({1})" "$KEEP_DEFAULT")}")")")
            done < <(guest_list)
            # guests gone from the node that still have a setting
            for id in "${!KEEP_BY_ID[@]}"; do
                [[ " ${items[*]} " == *" $id "* ]] || items+=("$id" "$(t "(not on this node) retains: {1}" "${KEEP_BY_ID[$id]}")")
            done
            ((${#items[@]})) || { msg "$(t "No guest was found.")"; continue; }
            id=$(menu "$(t "Select the guest:")" "${items[@]}") || continue
            v=$(input "$(t "Number of versions retained for guest {1}\n(empty = default value, 0 = retain every version):" "$id")" "${KEEP_BY_ID[$id]:-}") || continue
            if [[ -z $v ]]; then
                unset "KEEP_BY_ID[$id]"
            elif valid_count "$v"; then
                KEEP_BY_ID[$id]=$v
            else
                msg "$(t "The value entered is not valid.")"
                continue
            fi
            save_config
            ;;
        esac
    done
}

ui_prune() {
    need_ready || return
    confirm_no "$(t "Apply the retention policy now?\n\nFor each guest, the backups in excess of the configured number of versions will be deleted from {1}, oldest first." "$DEST_NAME")" || return
    ui_run "$(t "Retention on {1}" "$DEST_NAME")" op_locked prune_remote
}

# Runs a command while holding the lock
op_locked() { # command…
    local rc
    acquire_lock || return 1
    "$@"
    rc=$?
    release_lock
    return "$rc"
}

ui_about() {
    need_ready || return
    local out
    busy "$(t "Querying {1}…" "$DEST_NAME")"
    if out=$(rclone about "$BASE_REMOTE:" 2>/dev/null); then
        msg "$(t "Storage of the {1} account:\n\n{2}" "$DEST_NAME" "$out")"
    else
        # no quota information (S3, some SFTP servers): size of the backups
        out=$(rclone size "$CRYPT_REMOTE:" 2>&1)
        msg "$(t "Space used by the backups on {1}:\n\n{2}" "$DEST_NAME" "$out")"
    fi
}

ui_manage() {
    local choice
    pick_dest || return
    while :; do
        choice=$(CANCEL=Back menu "$(t "Management of the backups stored on {1}" "$DEST_NAME")" \
            L "$(t "List the backups")" \
            D "$(t "Delete backups")" \
            V "$(t "Retention policy")" \
            P "$(t "Apply the retention policy now")" \
            S "$(t "Storage used on {1}" "$DEST_NAME")") || return
        case $choice in
        L) ui_list ;;
        D) ui_delete ;;
        V) ui_retention ;;
        P) ui_prune ;;
        S) ui_about ;;
        esac
    done
}

# --- Restore -----------------------------------------------------------------

guest_exists() {
    compgen -G "/etc/pve/nodes/*/qemu-server/$1.conf" >/dev/null ||
        compgen -G "/etc/pve/nodes/*/lxc/$1.conf" >/dev/null
}

pick_storage() { # guest type -> storage name
    local content=images items=() name stype status avail
    [[ $1 == lxc ]] && content=rootdir
    while read -r name stype status _ _ avail _; do
        [[ $status == active ]] && items+=("$name" "$(printf '%-8s %s' "$stype" "$(t "{1} free" "$(human_size $((avail * 1024)))")")")
    done < <(pvesm status --content "$content" 2>/dev/null | tail -n +2)
    ((${#items[@]})) || { msg "$(t "No active storage accepts this type of disk.")"; return 1; }
    menu "$(t "Select the target storage for the disks:")" "${items[@]}"
}

ui_restore() {
    pick_dest "$(t "Select the source of the restore:")" || return
    load_backups || return
    ((${#BACKUPS[@]})) || { msg "$(t "No backup was found on {1}." "$DEST_NAME")"; return; }
    local items=() i sel id ts type name size path action target storage
    local force=() unique=() free
    for i in "${!BACKUPS[@]}"; do
        items+=("$i" "$(backup_label "${BACKUPS[$i]}")")
    done
    sel=$(menu "$(t "Select the backup to restore:")" "${items[@]}") || return
    IFS=$'\t' read -r id ts type name size path <<<"${BACKUPS[$sel]}"

    action=$(menu "$(t "Backup: {1} {2} ({3}) from {4}, {5}" "$type" "$id" "$name" "$(human_ts "$ts")" "$(human_size "$size")")" \
        O "$(t "Restore under the original ID ({1})" "$id")" \
        N "$(t "Restore under a new ID (as a copy)")" \
        D "$(t "Download the decrypted archive without restoring it")") || return

    case $action in
    O)
        target=$id
        if guest_exists "$target"; then
            confirm_no "$(t "Warning: guest {1} already exists.\n\nThe restore will overwrite its configuration and its disks. The guest must be stopped beforehand.\n\nDo you wish to continue?" "$target")" || return
            force=(--force 1)
        fi
        ;;
    N)
        target=$(input "$(t "New ID:")" "$(pvesh get /cluster/nextid 2>/dev/null)") || return
        [[ $target =~ ^[0-9]+$ ]] || { msg "$(t "The ID entered is not valid.")"; return; }
        guest_exists "$target" && { msg "$(t "ID {1} is already in use." "$target")"; return; }
        confirm "$(t "Generate new MAC addresses?\n\nThis is recommended when the original guest remains in service.")" && unique=(--unique 1)
        ;;
    D)
        target=$(input "$(t "Destination folder:")" "$STAGING_DIR") || return
        [[ -d $target && -w $target ]] || { msg "$(t "The folder does not exist or is not writable.")"; return; }
        ui_run "$(t "Download from {1}" "$DEST_NAME")" op_locked op_download "$path" "$target"
        return
        ;;
    esac

    storage=$(pick_storage "$type") || return
    free=$(df --output=avail -B1 "$STAGING_DIR" 2>/dev/null | tail -n1 | tr -d ' ')
    if [[ -n $free ]] && ((free < size)); then
        msg "$(t "There is not enough space in {1} to download the archive ({2} required, {3} available).\n\nPlease select another staging folder in the Configuration menu." "$STAGING_DIR" "$(human_size "$size")" "$(human_size "$free")")"
        return
    fi

    ui_run "$(t "Restore of {1} {2}" "$type" "$target")" op_locked op_restore "$path" "$type" "$target" "$storage" "${force[@]}" "${unique[@]}"
}

op_download() { # archive path on the remote, local folder
    log "$(t "Downloading {1} to {2}" "$1" "$2")"
    if rclone_copy "$CRYPT_REMOTE:$1" "$2"; then
        log "$(t "Archive available: {1}/{2}" "$2" "$(basename "$1")")"
    else
        log "ERROR: $(t "download from {1} failed." "$DEST_NAME")"
        return 1
    fi
}

op_restore() { # archive path on the remote, type, target ID, storage, options…
    local path=$1 type=$2 target=$3 storage=$4 tmp file rc
    shift 4
    tmp=$(mktemp -d "$STAGING_DIR/proxdump.XXXXXX") || return 1
    CLEANUP_DIRS+=("$tmp")
    log "=== $(t "Restoring {1} to {2} {3} (storage {4})" "$path" "$type" "$target" "$storage") ==="
    log "$(t "Downloading the archive from {1}…" "$DEST_NAME")"
    if rclone_copy "$CRYPT_REMOTE:$path" "$tmp"; then
        file="$tmp/$(basename "$path")"
        log "$(t "Restoring the archive to storage {1}…" "$storage")"
        if [[ $type == qemu ]]; then
            run_logged "" qmrestore "$file" "$target" --storage "$storage" "$@"
        else
            run_logged "" pct restore "$target" "$file" --storage "$storage" "$@"
        fi
        rc=$?
        if ((rc == 0)); then
            log "$(t "Restore complete: {1} {2}." "$type" "$target")"
        else
            log "ERROR: $(t "restore failed (exit code {1})." "$rc")"
        fi
    else
        log "ERROR: $(t "download from {1} failed." "$DEST_NAME")"
        rc=1
    fi
    rm -rf -- "$tmp"
    return "$rc"
}

# --- Configuration -----------------------------------------------------------

# Cleans up a pasted token: line breaks and spaces added by the terminal,
# '--->' and '<---End paste' markers copied by mistake
clean_token() {
    local t
    t=$(tr -d '[:space:]' <<<"$1")
    [[ $t == *'--->'* ]] && t=${t##*--->}
    t=${t%%<---*}
    printf '%s' "$t"
}

# True if the token is complete (rclone JSON, or its base64-encoded variant)
token_ok() {
    jq -e '.access_token | strings | length > 0' <<<"$1" >/dev/null 2>&1 ||
        base64 -d <<<"$1" 2>/dev/null | jq -e 'type == "object"' >/dev/null 2>&1
}

# Reads the token from the keyboard; a paste split over several lines is rejoined
read_token() {
    local buf="" line prompt="Token > "
    while read -e -r -p "$prompt" line; do
        if [[ -z $buf && -n $line && -f $line ]]; then
            buf=$(<"$line")
            break
        fi
        [[ -z $line ]] && break
        buf+=$line
        token_ok "$(clean_token "$buf")" && break
        prompt="  $(t "(continue pasting, or press Enter to finish)") > "
    done
    # leftovers of the paste, if any ('<---End paste'…)
    while read -r -s -t 0.3 line; do :; done
    clean_token "$buf"
}

# Drive choice: rclone also lists Microsoft's technical drives (metadata
# archives, 'bundles', raw identifiers) that are of no use here.
# If only one real drive is left, it is picked automatically.
pick_drive() { # rclone's JSON answer
    local out=$1 n i name items=() real=()
    local junk='^(ODCMetadataArchive|Bundles_[0-9a-f]+|[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}) '
    n=$(jq -r '.Option.Examples | length' <<<"$out")
    for ((i = 0; i < n; i++)); do
        name=$(jq -r ".Option.Examples[$i].Help" <<<"$out" | head -n1 | cut -c1-70)
        items+=("$i" "$name")
        [[ $name =~ $junk ]] || real+=("$i" "$name")
    done
    if ((${#real[@]} == 2)); then
        i=${real[0]}
    else
        ((${#real[@]} > 2)) && items=("${real[@]}")
        i=$(menu "$(t "Select the drive to use:")" "${items[@]}") || return 1
    fi
    jq -r ".Option.Examples[$i].Value" <<<"$out"
}

# Google Drive is reached through an OAuth client that belongs to the user.
# Explains how to create one and reads its two values, which stay on screen
# next to the instructions (into GD_CLIENT_ID and GD_CLIENT_SECRET).
gdrive_client() {
    screen "$(t "Google Drive: OAuth client")"
    t "$(cat <<'EOT'
Google Drive is accessed through an "OAuth client" that you create, free of
charge, in the Google Cloud console. This is done once, in a web browser on
any computer; the two values it produces are then entered below.

1. Open https://console.cloud.google.com/ and sign in to a Google account.
   Create a project: "Select a project" > "New project" (any name).
2. Menu "APIs & Services" > "Library": search for "Google Drive API", open
   it and click "Enable".
3. Menu "APIs & Services" > "OAuth consent screen" > "Get started": enter an
   application name (for instance rclone) and your e-mail address, choose
   the audience "External", accept the terms and click "Create".
4. "Data Access" > "Add or remove scopes": tick the scope ending in
   /auth/drive, then "Update" and "Save".
5. "Branding": fill in "Application home page" and "Application privacy
   policy link" with addresses of a domain of yours (for instance
   https://example.org and https://example.org/privacy), add that domain
   under "Authorized domains", then "Save". Google may then report that
   the branding could not be verified: ignore it, no verification is needed.
6. "Audience" > "Publish app" > "Confirm". Once published, the application
   needs no test users, and the authorization does not expire after 7 days.
7. "Clients" > "Create client": application type "Desktop app", then
   "Create". Google displays the client ID and the client secret.

The names between quotation marks are those of the console in English.
Press Enter on an empty line to cancel.
EOT
    )"
    echo
    while :; do
        read -e -r -p "Client ID > " GD_CLIENT_ID || return 1
        GD_CLIENT_ID=$(tr -d '[:space:]' <<<"$GD_CLIENT_ID")
        [[ -n $GD_CLIENT_ID ]] || return 1
        [[ $GD_CLIENT_ID == *.apps.googleusercontent.com ]] && break
        t "A client ID ends with '.apps.googleusercontent.com'. Please enter it again."
    done
    read -e -r -p "Client secret > " GD_CLIENT_SECRET || return 1
    GD_CLIENT_SECRET=$(tr -d '[:space:]' <<<"$GD_CLIENT_SECRET")
    [[ -n $GD_CLIENT_SECRET ]]
}

# Destinations reached with keys rather than through a browser are written
# straight into rclone.conf, so that their secrets never appear on a command
# line visible in 'ps'.
write_remote_section() { # 'key = value' lines
    install -d -m 700 "$CONF_DIR"
    touch "$RCLONE_CONFIG"
    chmod 600 "$RCLONE_CONFIG"
    rclone config delete "$BASE_REMOTE" 2>/dev/null
    printf '\n[%s]\ntype = %s\n%s\n' "$BASE_REMOTE" "${DEST_TYPES[$DEST]}" "$1" >>"$RCLONE_CONFIG"
}

trim() { sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$1"; }

# S3-compatible storage: provider, endpoint, access key and bucket
s3_setup() {
    local provider hint="" endpoint="" region="" key secret bucket conf
    provider=$(menu "$(t "Select the provider of the S3-compatible storage:")" \
        B2 "Backblaze B2" \
        Cloudflare "Cloudflare R2" \
        Wasabi "Wasabi" \
        AWS "Amazon S3" \
        Hetzner "Hetzner Object Storage" \
        OVHcloud "OVHcloud Object Storage" \
        Scaleway "Scaleway Object Storage" \
        Minio "$(t "MinIO (self-hosted)")" \
        Other "$(t "Another S3-compatible service")") || return 1
    case $provider in
    B2) hint=$(t "shown on the bucket in the Backblaze console, for instance s3.us-west-004.backblazeb2.com") ;;
    Cloudflare) hint=$(t "<account ID>.r2.cloudflarestorage.com, shown on the R2 overview page") ;;
    Wasabi) hint=$(t "for instance {1}" "s3.eu-central-1.wasabisys.com") ;;
    Hetzner) hint=$(t "for instance {1}" "fsn1.your-objectstorage.com") ;;
    OVHcloud) hint=$(t "for instance {1}" "s3.gra.io.cloud.ovh.net") ;;
    Scaleway) hint=$(t "for instance {1}" "s3.fr-par.scw.cloud") ;;
    Minio | Other) hint=$(t "host name or URL, for instance https://storage.example.org:9000") ;;
    esac
    if [[ $provider == AWS ]]; then
        region=$(input "$(t "Region of the bucket (for instance us-east-1):")") || return 1
        region=$(trim "$region")
        [[ -n $region ]] || { msg "$(t "The region is required for Amazon S3.")"; return 1; }
    else
        endpoint=$(input "$(t "Endpoint of the service ({1}):" "$hint")") || return 1
        endpoint=$(trim "$endpoint")
        [[ -n $endpoint ]] || { msg "$(t "The endpoint may not be empty.")"; return 1; }
        case $provider in
        Cloudflare) region=auto ;;
        B2) ;;
        *)
            region=$(input "$(t "Region, if the provider requires one (otherwise leave empty):")") || return 1
            region=$(trim "$region")
            ;;
        esac
    fi
    key=$(input "$(t "Access key ID (for Backblaze: keyID of an application key):")") || return 1
    key=$(trim "$key")
    secret=$(password "$(t "Secret access key (for Backblaze: applicationKey):")") || return 1
    secret=$(trim "$secret")
    [[ -n $key && -n $secret ]] || { msg "$(t "The access key and its secret are both required.")"; return 1; }
    bucket=$(input "$(t "Name of the bucket that will hold the backups.\n\nThe bucket must already exist; this tool does not create it.")" "${DEST_ROOT[s3]:-}") || return 1
    bucket=$(trim "$bucket")
    [[ -n $bucket && $bucket != */* ]] || { msg "$(t "The bucket name is not valid.")"; return 1; }

    [[ $provider == B2 ]] && provider=Other
    conf="provider = $provider"$'\n'"access_key_id = $key"$'\n'"secret_access_key = $secret"
    [[ -n $endpoint ]] && conf+=$'\n'"endpoint = $endpoint"
    [[ -n $region ]] && conf+=$'\n'"region = $region"
    # the bucket exists already, and a key restricted to it may not list or
    # create buckets
    conf+=$'\n'"no_check_bucket = true"
    write_remote_section "$conf"
    DEST_ROOT[s3]=$bucket
    save_config
}

# SFTP server: host, account, key or password, host key, folder
sftp_setup() {
    local host port user auth conf key="$CONF_DIR/sftp_key" known="$CONF_DIR/sftp_known_hosts" scan folder pass
    host=$(input "$(t "Host name or IP address of the SFTP server:")") || return 1
    host=$(trim "$host")
    [[ -n $host && $host != *[[:space:]/]* ]] || { msg "$(t "The host name is not valid.")"; return 1; }
    port=$(input "$(t "SSH port of the server:")" "22") || return 1
    [[ $port =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || { msg "$(t "The port is not valid.")"; return 1; }
    user=$(input "$(t "User name on the server:")") || return 1
    user=$(trim "$user")
    [[ -n $user ]] || { msg "$(t "The user name may not be empty.")"; return 1; }

    # the identity of the server is recorded now and checked at every connection
    busy "$(t "Contacting {1}…" "$host")"
    scan=$(ssh-keyscan -T 10 -p "$port" "$host" 2>/dev/null)
    [[ -n $scan ]] || { msg "$(t "No SSH server answered at {1}, port {2}." "$host" "$port")"; return 1; }
    confirm "$(t "The server presents the following host keys:\n\n{1}\n\nThey will be recorded, and the connection refused if they ever change. Compare them with those of the server if you have them.\n\nDo you wish to continue?" "$(ssh-keygen -lf - <<<"$scan" | awk '{print "  " $NF " " $2}')")" || return 1

    auth=$(menu "$(t "Select how this server signs in to {1}:" "$host")" \
        K "$(t "SSH key dedicated to this tool (recommended)")" \
        P "$(t "Password")") || return 1
    conf="host = $host"$'\n'"port = $port"$'\n'"user = $user"
    install -d -m 700 "$CONF_DIR"
    case $auth in
    K)
        if [[ ! -f $key ]]; then
            ssh-keygen -q -t ed25519 -N "" -C "proxdump@$(hostname -s)" -f "$key" ||
                { msg "$(t "The SSH key could not be generated.")"; return 1; }
        fi
        chmod 600 "$key"
        screen "$(t "SFTP server: SSH key")"
        t "$(cat <<'EOT'
The following public key identifies this server. Add it, on a single line,
to the file ~/.ssh/authorized_keys of the account '{1}' on {2} (or
through the control panel of the hosting provider):

{3}
EOT
        )" "$user" "$host" "$(cat "$key.pub")"
        echo
        read -rp "$(t "Press Enter once the key has been added.") " _
        conf+=$'\n'"key_file = $key"
        ;;
    P)
        pass=$(password "$(t "Password of '{1}' on {2}:" "$user" "$host")") || return 1
        [[ -n $pass ]] || { msg "$(t "The password may not be empty.")"; return 1; }
        pass=$(printf '%s\n' "$pass" | rclone obscure -) || return 1
        conf+=$'\n'"pass = $pass"
        ;;
    esac
    folder=$(input "$(t "Folder of the server that will hold the backups (created if necessary).\n\nA path without a leading '/' is relative to the home folder of '{1}'; leave empty to use the home folder itself." "$user")" "${DEST_ROOT[sftp]-backups}") || return 1
    folder=$(trim "$folder")
    [[ $folder != / ]] && folder=${folder%/}

    printf '%s\n' "$scan" >"$known"
    chmod 600 "$known"
    conf+=$'\n'"known_hosts_file = $known"
    write_remote_section "$conf"
    DEST_ROOT[sftp]=$folder
    save_config
}

# Drives rclone's configuration wizard, one question at a time, for the
# current destination
remote_wizard() {
    local out err bak state qname help def result n i items token args=()
    if [[ $DEST == gdrive ]]; then
        gdrive_client || return 1
        args=(scope=drive client_id="$GD_CLIENT_ID" client_secret="$GD_CLIENT_SECRET")
    fi
    err=$(mktemp)
    bak=$(mktemp)
    [[ -f $RCLONE_CONFIG ]] && cp -p "$RCLONE_CONFIG" "$bak"
    # on cancel or error, the previous configuration is put back
    wizard_abort() {
        if [[ -s $bak ]]; then cp -p "$bak" "$RCLONE_CONFIG"; else rclone config delete "$BASE_REMOTE" 2>/dev/null; fi
        rm -f "$err" "$bak"
        return 1
    }
    rclone config delete "$BASE_REMOTE" 2>/dev/null
    busy "$(t "Contacting {1}…" "$DEST_NAME")"
    out=$(rclone config create "$BASE_REMOTE" "${DEST_TYPES[$DEST]}" config_is_local=false "${args[@]}" --non-interactive 2>"$err")
    while :; do
        state=$(jq -r '.State // ""' <<<"$out" 2>/dev/null)
        # after an error rclone would go on with questions meant for experts
        # (a drive ID to type in…): the connection is abandoned instead
        if [[ -z $out || $(jq -r '.Error // ""' <<<"$out" 2>/dev/null) != "" ]]; then
            msg "$(t "rclone reported an error:\n\n{1}\n{2}" "$(jq -r '.Error // ""' <<<"$out" 2>/dev/null | grep -v 'manually instead')" "$(grep -i 'error' "$err" | tail -n 3)")"
            wizard_abort
            return 1
        fi
        [[ -z $state ]] && break
        qname=$(jq -r '.Option.Name' <<<"$out")
        help=$(jq -r '.Option.Help' <<<"$out")
        def=$(jq -r '.Option.DefaultStr // ""' <<<"$out")
        n=$(jq -r '.Option.Examples | length' <<<"$out")

        if [[ $qname == config_token ]]; then
            screen "$(t "{1} authorization" "$DEST_NAME")"
            t "$(cat <<'EOT'
This server has no web browser: access is authorized once, from another
computer, and the resulting token is pasted here.

1. On a computer equipped with a web browser, install rclone
   (https://rclone.org/downloads/), preferably the version used by this
   server: {1}.

2. On that computer, open a terminal and run, exactly as shown:

       {2}

3. The browser opens the {3} sign-in page. Sign in with the account
   that will hold the backups, then accept the access requested by rclone.
   The browser confirms with "Success!".

4. Back in the terminal of that computer, rclone displays the token between
   two markers:

       Paste the following into your remote machine --->
       {"access_token":"…","refresh_token":"…","expiry":"…"}
       <---End paste

   Copy everything between the markers and paste it below. Line breaks are
   accepted. Alternatively, save it to a file on this server and enter the
   path of that file.

The token grants access to the files of the account: treat it as a password.
Press Enter on an empty line to cancel.
EOT
            )" "$(rclone version 2>/dev/null | head -n1)" "$(grep -o 'rclone authorize .*' <<<"$help" | head -n1)" "${DEST_VENDORS[$DEST]}"
            echo
            while :; do
                token=$(read_token)
                [[ -n $token ]] || { wizard_abort; return 1; }
                token_ok "$token" && break
                echo
                t "The token is incomplete or invalid ({1} characters received): it must begin with '{' and end with '}'. Please paste it again in full, or press Enter to cancel." "${#token}"
                echo
                echo
            done
            result=$token
        elif [[ $qname == config_driveid ]] && ((n > 0)); then
            result=$(pick_drive "$out") || { wizard_abort; return 1; }
        elif [[ $qname == config_drive_ok ]]; then
            # rclone's final confirmation: the drive found, its type and its URL
            if confirm "$(t "Use the following drive?\n\n{1}" "$(sed '1d;/./,$!d' <<<"$help")")"; then result=true; else result=false; fi
        elif [[ $(jq -r '.Option.Type' <<<"$out") == bool ]]; then
            # the default answer is rclone's own
            if [[ $def == true ]]; then
                if confirm "$help"; then result=true; else result=false; fi
            else
                if confirm_no "$help"; then result=true; else result=false; fi
            fi
        elif ((n > 0)); then
            items=()
            for ((i = 0; i < n; i++)); do
                items+=("$(jq -r ".Option.Examples[$i].Value" <<<"$out")" "$(jq -r ".Option.Examples[$i].Help" <<<"$out" | head -n1 | cut -c1-70)")
            done
            result=$(menu "$help" "${items[@]}") || { wizard_abort; return 1; }
        else
            result=$(input "$help" "$def") || { wizard_abort; return 1; }
        fi
        busy "$(t "Contacting {1}…" "$DEST_NAME")"
        out=$(rclone config update "$BASE_REMOTE" --continue --state "$state" --result "$result" --non-interactive 2>"$err")
    done
    rm -f "$err" "$bak"
    chmod 600 "$RCLONE_CONFIG" 2>/dev/null
    return 0
}

# Deletes the credentials stored on this server. An authorization can only be
# withdrawn on the provider's side: the user is told where.
ui_remove_remote() {
    local n note="" where
    load_schedules
    n=${#SCHEDULES[@]}
    ((n)) && note="\n\n$(t "{1} schedule(s) are defined: those that use {2} will fail until a connection is configured again." "$n" "$DEST_NAME")"
    confirm_no "$(t "Remove the {1} connection from this server?\n\nThe credentials stored in {2} will be deleted. The backups on {1} and the encryption passphrase are kept.{3}\n\nDo you wish to continue?" "$DEST_NAME" "$RCLONE_CONFIG" "$note")" || return
    rclone config delete "$BASE_REMOTE" 2>>"$LOG_FILE"
    if has_remote "$BASE_REMOTE"; then
        msg "$(t "The {1} connection could not be removed. Please consult the log." "$DEST_NAME")"
        return
    fi
    keepalive_set "$DEST" off
    log "$(t "{1} connection removed from this server." "$DEST_NAME")" >/dev/null
    case $DEST in
    onedrive) where="$(t "The authorization granted to rclone remains registered with {1}. To withdraw it as well, remove the application from the list of authorized applications:" Microsoft)\n\n  $(t "Personal account:")\n    https://account.microsoft.com/privacy/app-access\n\n  $(t "Work or school account:")\n    https://myapps.microsoft.com" ;;
    gdrive) where="$(t "The authorization granted to rclone remains registered with {1}. To withdraw it as well, remove the application from the list of authorized applications:" Google)\n\n  https://myaccount.google.com/connections" ;;
    dropbox) where="$(t "The authorization granted to rclone remains registered with {1}. To withdraw it as well, remove the application from the list of authorized applications:" Dropbox)\n\n  https://www.dropbox.com/account/connected_apps" ;;
    s3) where=$(t "The access key itself remains valid. To withdraw it as well, delete it in the console of the storage provider.") ;;
    sftp) where=$(t "The SSH key of this tool ({1}) is kept for a later connection. To withdraw its access, remove its line from ~/.ssh/authorized_keys on the server." "$CONF_DIR/sftp_key") ;;
    esac
    msg "$(t "The {1} connection has been removed from this server.\n\n{2}" "$DEST_NAME" "$where")"
}

# Daily task that only queries the account, so that a token which is not
# used by any schedule does not lapse
ui_keepalive() {
    if keepalive_on "$DEST"; then
        confirm "$(t "The daily token refresh is enabled for {1}.\n\nDo you wish to disable it?" "$DEST_NAME")" || return
        keepalive_set "$DEST" off
    else
        confirm "$(t "The {1} access token lapses when it stays unused for {2}; the connection then has to be configured again.\n\nA daily task (at {3}) can query the account for the sole purpose of keeping the token active. It transfers no data, and its result is recorded in the log.\n\nThis is unnecessary when a schedule already backs up to {1} regularly.\n\nDo you wish to enable it?" "$DEST_NAME" "$(t "${DEST_TOKEN_LIFE[$DEST]}")" "$KEEPALIVE_TIME")" || return
        keepalive_set "$DEST" on
    fi
}

ui_setup_remote() { # for the current destination
    local choice items bak root
    if has_remote "$BASE_REMOTE"; then
        while :; do
            if [[ -n ${DEST_VENDORS[$DEST]:-} ]]; then
                items=(R "$(t "Replace the connection (sign in again, or use another account)")")
            else
                items=(R "$(t "Replace the connection (enter its settings again)")")
            fi
            [[ -n ${DEST_TOKEN_LIFE[$DEST]:-} ]] &&
                items+=(K "$(t "Daily token refresh: {1}" "$(keepalive_on "$DEST" && t "enabled" || t "disabled")")")
            items+=(D "$(t "Remove the connection from this server")")
            choice=$(CANCEL=Back menu "$(t "The {1} connection is configured.\n\nReplacing or removing it does not affect the backups already uploaded." "$DEST_NAME")" "${items[@]}") || return
            case $choice in
            K) ui_keepalive ;;
            D) ui_remove_remote; return ;;
            R) break ;;
            esac
        done
    fi
    install -d -m 700 "$CONF_DIR"
    if [[ -z ${DEST_VENDORS[$DEST]:-} ]]; then
        # entered by hand: kept only if it works, or if the user insists
        bak=$(mktemp)
        root=${DEST_ROOT[$DEST]-}
        [[ -f $RCLONE_CONFIG ]] && cp -p "$RCLONE_CONFIG" "$bak"
        if ! "${DEST}_setup"; then
            rm -f "$bak"
            msg "$(t "The {1} connection was not completed. The previous configuration, if any, is unchanged." "$DEST_NAME")"
            return
        fi
        ensure_crypt
        has_remote "$CRYPT_REMOTE" &&
            rclone config update "$CRYPT_REMOTE" remote="$(dest_base "$DEST")" --no-obscure >/dev/null 2>>"$LOG_FILE"
        if ! ui_test && ! confirm_no "$(t "Do you wish to keep these settings nevertheless?\n\nOtherwise the previous configuration, if any, is restored.")"; then
            if [[ -s $bak ]]; then cp -p "$bak" "$RCLONE_CONFIG"; else rclone config delete "$BASE_REMOTE" 2>/dev/null; fi
            DEST_ROOT[$DEST]=$root
            save_config
        fi
        rm -f "$bak"
        return
    fi
    choice=$(menu "$(t "Select the method used to connect to {1}:" "$DEST_NAME")" \
        G "$(t "Guided configuration (recommended)")" \
        M "$(t "Manual rclone configuration (special cases)")") || return
    case $choice in
    G)
        remote_wizard || { msg "$(t "The {1} connection was not completed. The previous configuration, if any, is unchanged." "$DEST_NAME")"; return; }
        ;;
    M)
        msg "$(t "The 'rclone config' tool will now open.\n\nCreate (n) a remote named exactly:\n\n    {1}\n\nof type '{2}', then quit (q)." "$BASE_REMOTE" "${DEST_TYPES[$DEST]}")"
        screen "$(t "Manual rclone configuration")"
        rclone config
        chmod 600 "$RCLONE_CONFIG" 2>/dev/null
        ;;
    esac
    ensure_crypt
    ui_test
}

# Checks that the current destination answers, and prints what it reports
dest_probe() {
    local root opts=(--contimeout 15s --timeout 30s --retries 1 --low-level-retries 1)
    if [[ -n ${DEST_VENDORS[$DEST]:-} ]]; then
        rclone about "$BASE_REMOTE:" "${opts[@]}"
        return
    fi
    root=${DEST_ROOT[$DEST]:-}
    if [[ $DEST == sftp && -n $root ]]; then
        rclone mkdir "$BASE_REMOTE:$root" "${opts[@]}" || return 1
    fi
    rclone lsf --max-depth 1 "$BASE_REMOTE:$root" "${opts[@]}" >/dev/null || return 1
    case $DEST in
    s3) t "The bucket '{1}' is accessible." "$root" ;;
    *) t "The folder '{1}' is accessible." "${root:-$(t "(home folder)")}" ;;
    esac
}

ui_test() {
    local out
    has_remote "$BASE_REMOTE" || { msg "$(t "The {1} connection is not configured." "$DEST_NAME")"; return 1; }
    busy "$(t "Testing the {1} connection…" "$DEST_NAME")"
    if out=$(dest_probe 2>&1); then
        msg "$(t "The {1} connection is operational.\n\n{2}" "$DEST_NAME" "$out")"
    else
        msg "$(t "The {1} connection failed:\n\n{2}" "$DEST_NAME" "$(tail -n 8 <<<"$out")")"
        return 1
    fi
}

# rclone crypt always encrypts the contents (XSalsa20-Poly1305, 256-bit key).
# File and folder names are kept as they are, with an '.encrypted' suffix.
CRYPT_NAMES=$'filename_encryption = off\ndirectory_name_encryption = false\nsuffix = .encrypted'

# True if the crypt remote already stores plain names with the suffix
names_plain() {
    rclone config dump 2>/dev/null | jq -e --arg n "$CRYPT_REMOTE" \
        '.[$n] | .filename_encryption == "off" and .suffix == ".encrypted"' >/dev/null
}

# The passphrase is shared by every destination: the first crypt remote
# found provides it.
obscured_passphrase() {
    rclone config dump 2>/dev/null | jq -r --args '
        [ $ARGS.positional[] as $id | .[$id + "-crypt"].password // empty ] | first // empty' \
        "${DEST_IDS[@]}"
}

current_passphrase() {
    local obscured
    obscured=$(obscured_passphrase)
    [[ -n $obscured ]] && rclone reveal "$obscured"
}

# Writes the crypt section straight into rclone.conf, so the passphrase never
# appears on a command line visible in 'ps'.
write_crypt_section() { # obscured passphrase, destinations (default: all)
    local obscured=$1 id
    shift
    (($#)) || set -- "${DEST_IDS[@]}"
    install -d -m 700 "$CONF_DIR"
    touch "$RCLONE_CONFIG"
    chmod 600 "$RCLONE_CONFIG"
    for id; do
        rclone config delete "$id-crypt" 2>/dev/null
        printf '\n[%s]\ntype = crypt\nremote = %s\npassword = %s\n%s\n' \
            "$id-crypt" "$(dest_base "$id")" "$obscured" "$CRYPT_NAMES" >>"$RCLONE_CONFIG"
    done
}

# Gives every destination its crypt remote once a passphrase exists (a
# destination added by a newer version, or connected after the encryption
# was configured).
ensure_crypt() {
    local obscured id remotes missing=()
    remotes=$(rclone listremotes 2>/dev/null)
    for id in "${DEST_IDS[@]}"; do
        grep -qxF "$id-crypt:" <<<"$remotes" || missing+=("$id")
    done
    ((${#missing[@]})) || return 0
    obscured=$(obscured_passphrase)
    [[ -n $obscured ]] || return 0
    write_crypt_section "$obscured" "${missing[@]}"
}

write_crypt_remote() { # passphrase
    local obscured
    obscured=$(printf '%s\n' "$1" | rclone obscure -) || return 1
    write_crypt_section "$obscured"
}

# Earlier versions could encrypt or scramble the names. This converts such an
# installation: the contents are encrypted the same way whatever the naming,
# so the backups already uploaded are only renamed there (nothing is
# uploaded again).
migrate_names() {
    local obscured json err base path old enc n=0 failed=0
    obscured=$(obscured_passphrase)
    [[ -n $obscured ]] || return 1
    base=$(dest_base "$DEST")
    err=$(mktemp)
    if ! json=$(rclone lsjson -R --files-only --encrypted "$CRYPT_REMOTE:" 2>"$err"); then
        if grep -q "directory not found" "$err"; then
            json='[]'
        else
            cat "$err" >>"$LOG_FILE"
            rm -f "$err"
            log "ERROR: $(t "{1} could not be read; the file names were left unchanged" "$DEST_NAME")"
            return 1
        fi
    fi
    rm -f "$err"
    write_crypt_section "$obscured" "$DEST" || return 1
    while IFS=$'\t' read -r path old; do
        [[ -n $path ]] || continue
        enc=$(rclone cryptdecode --reverse "$CRYPT_REMOTE:" "$path" 2>>"$LOG_FILE" </dev/null |
            awk -F' \t ' '{print $2}')
        [[ -n $enc ]] || { log "ERROR: $(t "no new name for {1}" "$path")"; failed=$((failed + 1)); continue; }
        [[ $enc == "$old" ]] && continue
        log "$(t "Renaming {1}" "$path")"
        if rclone moveto "$base/$old" "$base/$enc" --log-file "$LOG_FILE" --log-level NOTICE </dev/null; then
            n=$((n + 1))
        else
            log "ERROR: $(t "{1} could not be renamed (still stored as {2})" "$path" "$old")"
            failed=$((failed + 1))
        fi
    done < <(jq -r '.[] | [.Path, .EncryptedPath] | @tsv' <<<"$json")
    rclone rmdirs "$base" --leave-root 2>>"$LOG_FILE"
    log "$(t "File names converted: {1} file(s) renamed, {2} failure(s)." "$n" "$failed")"
    return "$failed"
}

ui_migrate_names() {
    confirm "$(t "The backups on {1} are stored under encrypted file names, as produced by an earlier version.\n\nThis version stores them under their original names followed by '.encrypted'. The existing backups can be renamed accordingly; their contents remain encrypted and nothing is uploaded again.\n\nDo you wish to convert them now?" "$DEST_NAME")" || return
    ui_run "$(t "Conversion of the file names on {1}" "$DEST_NAME")" op_locked migrate_names
}

ui_setup_crypt() {
    local choice p1 p2
    if [[ -n $(obscured_passphrase) ]]; then
        choice=$(CANCEL=Back menu "$(t "Encryption is configured. The same passphrase is used for every destination.\n\nThe contents of every file are encrypted (XSalsa20-Poly1305, 256-bit key). File names remain legible and carry the '.encrypted' suffix.")" \
            S "$(t "Display the passphrase (to record it in a safe place)")" \
            C "$(t "Change the passphrase")") || return
        case $choice in
        S)
            msg "$(t "Encryption passphrase:\n\n{1}\n\nPlease keep it outside this server (password manager, printed copy). Without it, the backups cannot be recovered." "$(current_passphrase)")"
            return
            ;;
        C)
            confirm_no "$(t "Warning: the backups already uploaded were encrypted with the current passphrase. Once it is changed, this tool will no longer be able to read them unless the former passphrase is restored.\n\nDo you wish to continue?")" || return
            ;;
        esac
    fi
    choice=$(menu "$(t "Encryption passphrase\n\nThe passphrase protects the files uploaded to every destination. Restoring from another server requires exactly the same passphrase.")" \
        G "$(t "Generate a strong random passphrase (recommended)")" \
        E "$(t "Enter a passphrase (a new one, or that of an existing installation)")") || return
    case $choice in
    G)
        p1=$(openssl rand -base64 33 | tr -d '\n')
        ;;
    E)
        p1=$(password "$(t "Passphrase (at least 12 characters):")") || return
        p2=$(password "$(t "Confirm the passphrase:")") || return
        [[ $p1 == "$p2" ]] || { msg "$(t "The two entries do not match.")"; return; }
        ((${#p1} >= 12)) || { msg "$(t "The passphrase is too short (at least 12 characters are required).")"; return; }
        ;;
    esac
    write_crypt_remote "$p1" || { msg "$(t "The encryption settings could not be saved.")"; return; }
    save_config
    msg "$(t "Encryption is configured.\n\nPassphrase:\n\n{1}\n\nPlease record it now, outside this server. Without it, no restore is possible should this server be lost." "$p1")"
}

ui_remote_dir() {
    local v id
    v=$(input "$(t "Folder used on each destination (created if necessary).\n\nPlease note that existing backups are not moved.")" "$REMOTE_DIR") || return
    v=${v#/}
    v=${v%/}
    [[ -n $v ]] || { msg "$(t "The folder name may not be empty.")"; return; }
    REMOTE_DIR=$v
    save_config
    for id in "${DEST_IDS[@]}"; do
        has_remote "$id-crypt" &&
            rclone config update "$id-crypt" remote="$(dest_base "$id")" --no-obscure >/dev/null 2>>"$LOG_FILE"
    done
}

ui_staging() {
    local items=() name stype status rest path v
    while read -r name stype status rest; do
        [[ $status == active && $stype =~ ^(dir|nfs|cifs|btrfs|cephfs)$ ]] || continue
        path=$(pvesh get "/storage/$name" --output-format json 2>/dev/null | jq -r '.path // empty')
        [[ -n $path ]] && items+=("$path/dump" "$(t "storage {1} — {2} free" "$name" "$(df -h --output=avail "$path" 2>/dev/null | tail -n1 | tr -d ' ')")")
    done < <(pvesm status --content backup 2>/dev/null | tail -n +2)
    items+=("other" "$(t "Enter another path")")
    v=$(menu "$(t "Local staging folder for vzdump\n\nEach archive is created there by vzdump, uploaded, then deleted. The folder must have enough free space for the largest backup.\n\nCurrent folder: {1}" "$STAGING_DIR")" "${items[@]}") || return
    [[ $v == other ]] && { v=$(input "$(t "Staging folder path:")" "$STAGING_DIR") || return; }
    mkdir -p "$v" 2>/dev/null
    [[ -d $v && -w $v ]] || { msg "$(t "The folder cannot be used: {1}" "$v")"; return; }
    STAGING_DIR=$v
    save_config
}

ui_options() {
    local choice v
    while :; do
        choice=$(CANCEL=Back menu "$(t "Backup options")" \
            M "$(t "vzdump mode: {1}" "$VZDUMP_MODE")" \
            C "$(t "Compression: {1}" "$COMPRESS")" \
            L "$(t "Upload rate limit: {1}" "${BWLIMIT:-$(t "none")}")" \
            V "$(t "Verification after upload: {1}" "$([[ $VERIFY == 1 ]] && t "enabled" || t "disabled")")") || return
        case $choice in
        M)
            v=$(menu "$(t "vzdump mode")" \
                snapshot "$(t "No interruption of service (recommended)")" \
                suspend "$(t "Brief suspension of the guest")" \
                stop "$(t "Guest stopped for the duration of the backup (highest consistency)")") || continue
            VZDUMP_MODE=$v
            ;;
        C)
            v=$(menu "$(t "Compression")" \
                zstd "$(t "Fast, with a good compression ratio (recommended)")" \
                gzip "$(t "Widely compatible, slower")" \
                lzo "$(t "Very fast, lower compression ratio")" \
                0 "$(t "None")") || continue
            COMPRESS=$v
            ;;
        L)
            v=$(input "$(t "rclone rate limit (e.g. 10M = 10 MiB/s; empty = none):")" "$BWLIMIT") || continue
            [[ -z $v || $v =~ ^[0-9]+(\.[0-9]+)?[BKMG]?$ ]] || { msg "$(t "The format entered is not valid.")"; continue; }
            BWLIMIT=$v
            ;;
        V) VERIFY=$((1 - VERIFY)) ;;
        esac
        save_config
    done
}

ui_test_all() {
    local id found=0
    for id in "${DEST_IDS[@]}"; do
        has_remote "$id" || continue
        found=1
        use_dest "$id"
        ui_test
    done
    ((found)) || msg "$(t "No connection is configured.")"
}

ui_language() {
    local items=() code choice
    items=(auto "$(t "Language of the system")")
    for code in "${LANG_CODES[@]}"; do
        items+=("$code" "${LANG_NAMES[$code]}")
    done
    choice=$(menu "$(t "Select the language of the interface and of the log:")" "${items[@]}") || return
    [[ $choice == auto ]] && choice=""
    UI_LANG=$choice
    save_config
    load_language
    use_dest "$DEST"
    if [[ -n $choice && $choice != en && $CUR_LANG != "$choice" ]]; then
        msg "The translation files were not found in $LANG_DIR; please run install.sh again."
    fi
}

# i18n: "Classic (whiptail)" "Native (drawn by proxdump)" "Automatic"
ui_interface() {
    local choice v id items
    local -A styles=([whiptail]="Classic (whiptail)" [native]="Native (drawn by proxdump)")
    while :; do
        v=$(t "Automatic")
        [[ $UI_THEME != auto && -n ${THEME_NAMES[$UI_THEME]:-} ]] && v=$(t "${THEME_NAMES[$UI_THEME]}")
        [[ -n ${THEME_NAMES[*]:-} ]] || v=$UI_THEME
        choice=$(CANCEL=Back menu "$(t "Appearance of the interface")" \
            S "$(t "Style: {1}" "$(t "${styles[$UI_STYLE]:-$UI_STYLE}")")" \
            T "$(t "Colour theme (native style): {1}" "$v")" \
            M "$(t "Mouse (native style): {1}" "$([[ $UI_MOUSE == 1 ]] && t "enabled" || t "disabled")")") || return
        case $choice in
        S)
            v=$(menu "$(t "Select the style of the interface:")" \
                whiptail "$(t "Classic (whiptail)")" \
                native "$(t "Native (drawn by proxdump)")") || continue
            [[ $v == "$UI_STYLE" ]] && continue
            if [[ $v == native && ! -r $LIB_DIR/tui.sh ]]; then
                msg "$(t "The native interface is not installed ({1} is missing); please run install.sh again." "$LIB_DIR/tui.sh")"
                continue
            fi
            UI_STYLE=$v
            save_config
            msg "$(t "The new style will be used the next time proxdump is started.")"
            ;;
        T)
            if ! declare -F theme_load >/dev/null; then
                msg "$(t "The colour themes apply to the native style; select it first, then start proxdump again.")"
                continue
            fi
            items=(auto "$(t "Automatic")")
            for id in "${THEME_IDS[@]}"; do items+=("$id" "$(t "${THEME_NAMES[$id]}")"); done
            v=$(menu "$(t "Select the colour theme:")" "${items[@]}") || continue
            UI_THEME=$v
            save_config
            theme_load
            ;;
        M)
            UI_MOUSE=$((1 - UI_MOUSE))
            save_config
            ;;
        esac
    done
}

ui_config() {
    local choice items i
    while :; do
        items=()
        for i in "${!DEST_IDS[@]}"; do
            items+=("$((i + 1))" "$(t "{1} connection: {2}" "$(t "${DEST_NAMES[${DEST_IDS[$i]}]}")" "$(has_remote "${DEST_IDS[$i]}" && t "configured" || t "not configured")")")
        done
        choice=$(CANCEL=Back menu "$(t "Configuration (stored in {1}, readable by root only)" "$CONF_DIR")" \
            "${items[@]}" \
            E "$(t "Encryption: {1}" "$([[ -n $(obscured_passphrase) ]] && t "configured" || t "not configured")")" \
            T "$(t "Test the connections")" \
            D "$(t "Folder on the destinations: {1}" "$REMOTE_DIR")" \
            L "$(t "Local staging folder: {1}" "$STAGING_DIR")" \
            S "$(t "Backup options")" \
            G "$(t "Language: {1}" "${LANG_NAMES[$CUR_LANG]}")" \
            I "$(t "Appearance of the interface")") || return
        case $choice in
        G) ui_language ;;
        I) ui_interface ;;
        E) ui_setup_crypt ;;
        T) ui_test_all ;;
        D) ui_remote_dir ;;
        L) ui_staging ;;
        S) ui_options ;;
        *)
            use_dest "${DEST_IDS[choice - 1]}"
            ui_setup_remote
            ;;
        esac
    done
}

# --- Scheduling --------------------------------------------------------------

# Each schedule is one line of $CRON_FILE:
#   MIN HOUR * * DOW root <proxdump> backup --to DEST (--all | ID…) >/dev/null 2>&1
# and so is each daily token refresh:
#   MIN HOUR * * * root <proxdump> keepalive --to DEST >/dev/null 2>&1
SCHEDULES=()
KEEPALIVES=()
KEEPALIVE_TIME="12:17"

load_schedules() {
    SCHEDULES=()
    KEEPALIVES=()
    [[ -f $CRON_FILE ]] || return 0
    mapfile -t SCHEDULES < <(grep -E '^[0-9]+ [0-9]+ \* \* [0-9*] root [^ ]+ backup ' "$CRON_FILE")
    mapfile -t KEEPALIVES < <(grep -E '^[0-9]+ [0-9]+ \* \* \* root [^ ]+ keepalive --to [a-z0-9]+ ' "$CRON_FILE")
}

save_schedules() {
    if ((${#SCHEDULES[@]} + ${#KEEPALIVES[@]} == 0)); then
        rm -f "$CRON_FILE"
        return
    fi
    {
        echo "# Generated by proxdump — edit through the 'Automatic scheduling' and 'Configuration' menus"
        echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        ((${#SCHEDULES[@]})) && printf '%s\n' "${SCHEDULES[@]}"
        ((${#KEEPALIVES[@]})) && printf '%s\n' "${KEEPALIVES[@]}"
    } >"$CRON_FILE"
    chmod 644 "$CRON_FILE"
}

self_path() {
    command -v proxdump || readlink -f "${BASH_SOURCE[0]}"
}

keepalive_on() { # id
    [[ -f $CRON_FILE ]] && grep -qE " keepalive --to $1 " "$CRON_FILE"
}

keepalive_set() { # id, on|off
    local line kept=()
    load_schedules
    for line in "${KEEPALIVES[@]}"; do
        [[ $line == *" keepalive --to $1 "* ]] || kept+=("$line")
    done
    [[ $2 == on ]] &&
        kept+=("$((10#${KEEPALIVE_TIME#*:})) $((10#${KEEPALIVE_TIME%:*})) * * * root $(self_path) keepalive --to $1 >/dev/null 2>&1")
    KEEPALIVES=("${kept[@]}")
    save_schedules
}

# Queries the account of each destination in DESTS whose token can lapse:
# rclone renews the token on the way and saves it.
keepalive() {
    local d out rc=0
    for d in "${DESTS[@]}"; do
        [[ -n ${DEST_TOKEN_LIFE[$d]:-} ]] || continue
        use_dest "$d"
        if out=$(rclone about "$BASE_REMOTE:" --retries 2 2>&1); then
            log "$(t "{1} token refreshed." "$DEST_NAME")"
        else
            log "ERROR: $(t "the {1} token could not be refreshed: {2}" "$DEST_NAME" "$(tail -n 1 <<<"$out")")"
            rc=1
        fi
    done
    return "$rc"
}

# Splits a cron line into S_MIN, S_HOUR, S_DOW, S_DEST and S_TARGETS
# (S_TARGETS is '--all' or a list of IDs)
schedule_parse() {
    read -r S_MIN S_HOUR _ _ S_DOW _ _ _ S_TARGETS <<<"$1"
    S_TARGETS=${S_TARGETS% >/dev/null 2>&1}
    S_DEST="" # no --to: every configured destination
    if [[ $S_TARGETS == "--to "* ]]; then
        S_TARGETS=${S_TARGETS#--to }
        S_DEST=${S_TARGETS%% *}
        S_TARGETS=${S_TARGETS#* }
    fi
}

# i18n: "Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"
schedule_label() { # cron line -> readable label
    local when what time days=(Sunday Monday Tuesday Wednesday Thursday Friday Saturday)
    schedule_parse "$1"
    printf -v time '%02d:%02d' "$S_HOUR" "$S_MIN"
    if [[ $S_DOW == "*" ]]; then
        when=$(t "Daily at {1}" "$time")
    else
        when=$(t "Weekly on {1} at {2}" "$(t "${days[S_DOW]}")" "$time")
    fi
    if [[ $S_TARGETS == --all ]]; then what=$(t "all guests"); else what=$(t "guests {1}" "$S_TARGETS"); fi
    t "{1}, {2}, to {3}" "$when" "$what" "$(dest_label "$S_DEST")"
}

# Runs a schedule at once, exactly as cron would, with the progress on screen
ui_schedule_run() { # cron line
    local ids err
    schedule_parse "$1"
    err=$(set_dests "$S_DEST") || { msg "$(t "This schedule cannot be run: {1}." "$err")"; return; }
    set_dests "$S_DEST"
    ids=$S_TARGETS
    if [[ $ids == --all ]]; then
        ids=$(guest_list | cut -f1 | tr '\n' ' ')
        [[ -n ${ids// /} ]] || { msg "$(t "No virtual machine or container was found on this node.")"; return; }
    fi
    confirm "$(t "Run the following schedule now?\n\n{1}\n\nThe schedule itself is not modified." "$(schedule_label "$1")")" || return
    # shellcheck disable=SC2086
    ui_run "$(t "Backup")" backup_guests $ids
}

# Asks which guests a schedule includes and prints them: '--all' or a list
# of IDs. The guests of the current choice, if given, are ticked; those that
# are no longer on the node stay in the list, so that they can be removed.
schedule_guests() { # current targets
    local items=() id type name status sel cur=" ${1:-} " seen=" " choice
    choice=$(menu "$(t "Guests included in this schedule")" \
        A "$(t "All guests on the node, including those added later")" \
        S "$(t "Selected guests only")") || return 1
    if [[ $choice == A ]]; then
        echo "--all"
        return 0
    fi
    [[ $cur == " --all " ]] && cur=" "
    while IFS=$'\t' read -r id type name status; do
        [[ -n $id ]] || continue
        items+=("$id" "$(printf '%-4s %s' "$type" "$name")" "$([[ $cur == *" $id "* ]] && echo ON || echo OFF)")
        seen+="$id "
    done < <(guest_list)
    for id in $cur; do
        [[ $seen == *" $id "* ]] || items+=("$id" "$(t "not found on this node")" ON)
    done
    ((${#items[@]})) || { msg "$(t "No virtual machine or container was found on this node.")"; return 1; }
    sel=$(checklist "$(t "Select the guests to back up (Space to select, Enter to confirm).")" "${items[@]}") || return 1
    [[ -n $sel ]] || { msg "$(t "No guest was selected.")"; return 1; }
    sel=$(tr '\n' ' ' <<<"$sel")
    echo "${sel% }"
}

# Replaces the guests of a schedule; when, where and how stay the same
ui_schedule_guests() { # index in SCHEDULES
    local line=${SCHEDULES[$1]} targets new i
    schedule_parse "$line"
    targets=$(schedule_guests "$S_TARGETS") || return
    [[ $targets == "$S_TARGETS" ]] && return
    new="${line%% backup *} backup ${S_DEST:+--to $S_DEST }$targets >/dev/null 2>&1"
    for i in "${!SCHEDULES[@]}"; do
        [[ ${SCHEDULES[$i]} == "$new" ]] && { msg "$(t "An identical schedule already exists.")"; return; }
    done
    SCHEDULES[$1]=$new
    save_schedules
    msg "$(t "The schedule has been saved:\n\n{1}\n\nProgress is recorded in {2}." "$(schedule_label "$new")" "$LOG_FILE")"
}

ui_schedule_add() {
    local id dest choice dow="*" time hour min targets self line
    pick_dests || return
    dest=$(IFS=,; echo "${DESTS[*]}")

    choice=$(menu "$(t "Frequency of the backup")" \
        D "$(t "Daily")" \
        W "$(t "Weekly")") || return
    if [[ $choice == W ]]; then
        dow=$(menu "$(t "Select the day of the week:")" 1 "$(t "Monday")" 2 "$(t "Tuesday")" 3 "$(t "Wednesday")" 4 "$(t "Thursday")" 5 "$(t "Friday")" 6 "$(t "Saturday")" 0 "$(t "Sunday")") || return
    fi
    time=$(input "$(t "Start time (HH:MM, 24-hour clock):")" "02:00") || return
    [[ $time =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || { msg "$(t "The time entered is not valid.")"; return; }
    hour=$((10#${BASH_REMATCH[1]}))
    min=$((10#${BASH_REMATCH[2]}))

    targets=$(schedule_guests) || return

    self=$(self_path)
    line="$min $hour * * $dow root $self backup --to $dest $targets >/dev/null 2>&1"
    load_schedules
    for id in "${SCHEDULES[@]}"; do
        [[ $id == "$line" ]] && { msg "$(t "An identical schedule already exists.")"; return; }
    done
    SCHEDULES+=("$line")
    save_schedules
    msg "$(t "The schedule has been saved:\n\n{1}\n\nProgress is recorded in {2}." "$(schedule_label "$line")" "$LOG_FILE")"
}

ui_schedule() {
    local choice items i label
    while :; do
        load_schedules
        items=(A "$(t "Add a schedule")")
        for i in "${!SCHEDULES[@]}"; do
            items+=("$((i + 1))" "$(schedule_label "${SCHEDULES[$i]}")")
        done
        choice=$(CANCEL=Back menu "$(t "Automatic backups (cron): {1} schedule(s) defined.\n\nSelect a schedule to run it now, to change its guests or to remove it, or add a new one. Schedules that overlap are run one after the other." "${#SCHEDULES[@]}")" "${items[@]}") || return
        if [[ $choice == A ]]; then
            ui_schedule_add
            continue
        fi
        i=$((choice - 1))
        label=$(schedule_label "${SCHEDULES[$i]}")
        choice=$(CANCEL=Back menu "$label" \
            R "$(t "Run this schedule now")" \
            G "$(t "Change the guests included")" \
            D "$(t "Remove this schedule")") || continue
        case $choice in
        R) ui_schedule_run "${SCHEDULES[$i]}" ;;
        G) ui_schedule_guests "$i" ;;
        D)
            confirm_no "$(t "Remove the following schedule?\n\n{1}" "$label")" || continue
            unset "SCHEDULES[$i]"
            SCHEDULES=("${SCHEDULES[@]}")
            save_schedules
            ;;
        esac
    done
}

ui_log() {
    local tmp
    [[ -s $LOG_FILE ]] || { msg "$(t "The log is empty.")"; return; }
    tmp=$(mktemp)
    tail -n 300 "$LOG_FILE" >"$tmp"
    textbox "$(t "{1} — {2} (last 300 lines)" "$TITLE" "$LOG_FILE")" "$tmp"
    rm -f "$tmp"
}

main_menu() {
    local choice
    local id
    ensure_crypt
    if [[ -z $(dest_list) ]]; then
        msg "$(t "proxdump has not been configured yet.\n\nBefore the first backup, please open the 'Configuration' menu in order to:\n\n  1. connect at least one destination;\n  2. define the encryption passphrase;\n  3. select the local staging folder for vzdump.")"
    fi
    for id in $(dest_list | cut -f1); do
        use_dest "$id"
        names_plain || ui_migrate_names
    done
    while :; do
        choice=$(CANCEL=Quit menu "$(t "Encrypted backup of Proxmox VE to cloud storage (node: {1})" "$(hostname -s)")" \
            1 "$(t "Back up virtual machines and containers")" \
            2 "$(t "Restore a backup")" \
            3 "$(t "Manage the stored backups")" \
            4 "$(t "Automatic scheduling")" \
            5 "$(t "Configuration")" \
            6 "$(t "Log")") || break
        case $choice in
        1) ui_backup ;;
        2) ui_restore ;;
        3) ui_manage ;;
        4) ui_schedule ;;
        5) ui_config ;;
        6) ui_log ;;
        esac
    done
    if declare -F tui_leave >/dev/null; then tui_leave; else clear; fi
}

# --- Update ------------------------------------------------------------------

PROJECT_REPO="Mrdindon/proxdump"

# Installs the latest release published on GitHub if it is newer than this
# one, the way this copy was installed: the Debian package (checked against
# the digest GitHub publishes), or the archive of the release and its
# install.sh. A copy run from a git clone is left to git.
update() { # [--check]
    local self dir rel tag latest pkg asset url digest tmp
    self=$(readlink -f "${BASH_SOURCE[0]}")
    dir=$(dirname "$self")
    rel=$(curl -fsSL --max-time 30 "https://api.github.com/repos/$PROJECT_REPO/releases/latest") ||
        die "$(t "the latest version could not be obtained from GitHub.")"
    tag=$(jq -r '.tag_name // ""' <<<"$rel")
    latest=${tag#v}
    [[ $latest =~ ^[0-9][0-9.]*$ ]] || die "$(t "the latest version could not be obtained from GitHub.")"
    if dpkg --compare-versions "$latest" le "$VERSION"; then
        t "proxdump {1} is up to date." "$VERSION"
        return 0
    fi
    t "proxdump {1} is available (installed: {2})." "$latest" "$VERSION"
    [[ ${1:-} == --check ]] && return 0

    if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        t "This copy runs from a git clone ({1}): update it with 'git pull'." "$dir"
        return 1
    fi
    # the files are not replaced under a backup or a restore
    acquire_lock || return 1
    tmp=$(mktemp -d)
    CLEANUP_DIRS+=("$tmp")
    pkg=$(dpkg -S "$self" 2>/dev/null | cut -d: -f1)
    if [[ -n $pkg ]]; then
        asset=$(jq -c '[.assets[] | select(.name | endswith("_all.deb"))][0] // empty' <<<"$rel")
        [[ -n $asset ]] || die "$(t "the release {1} has no Debian package." "$tag")"
        url=$(jq -r '.browser_download_url' <<<"$asset")
        digest=$(jq -r '.digest // "" | ltrimstr("sha256:")' <<<"$asset")
        t "Downloading {1}…" "${url##*/}"
        curl -fsSL --max-time 300 -o "$tmp/${url##*/}" "$url" || die "$(t "the download failed.")"
        if [[ -n $digest ]]; then
            [[ $(sha256sum "$tmp/${url##*/}" | cut -d' ' -f1) == "$digest" ]] ||
                die "$(t "the downloaded file does not match the checksum published by GitHub; nothing was installed.")"
        fi
        apt-get install -y "$tmp/${url##*/}" || die "$(t "the installation failed.")"
    else
        url="https://github.com/$PROJECT_REPO/archive/refs/tags/$tag.tar.gz"
        t "Downloading {1}…" "$PROJECT_REPO $tag"
        curl -fsSL --max-time 300 "$url" | tar -xz -C "$tmp" --strip-components=1 ||
            die "$(t "the download failed.")"
        [[ -f $tmp/install.sh ]] || die "$(t "the download failed.")"
        bash "$tmp/install.sh" || die "$(t "the installation failed.")"
    fi
    release_lock
    log "$(t "proxdump updated from {1} to {2}." "$VERSION" "$latest")"
}

# --- Command line ------------------------------------------------------------

usage() {
    cat <<EOF
proxdump $VERSION — encrypted Proxmox VE backup to cloud storage

Usage:
  proxdump                               open the menus
  proxdump backup [--to DEST] --all      back up every guest on the node
  proxdump backup [--to DEST] ID [ID…]   back up the given guests
  proxdump list [--to DEST]              list the stored backups
  proxdump prune [--to DEST]             apply retention
  proxdump keepalive [--to DEST]         renew the access tokens that can lapse
  proxdump update [--check]              install the latest release, if newer
  proxdump --version | --help

DEST is one or more destinations separated by commas: ${DEST_IDS[*]}.
Without --to, every configured destination is used.

Restore and configuration are done through the menus.
EOF
}

main() {
    case ${1:-} in
    -h | --help) usage; exit 0 ;;
    --version) echo "$VERSION"; exit 0 ;;
    esac
    ((EUID == 0)) || die "$(t "proxdump must be run as root.")"
    check_deps
    load_config
    case ${1:-} in
    update | -update | --update) shift; update "$@"; exit ;;
    esac

    local ids line cmd=${1:-} err d
    if [[ -n $cmd ]]; then
        shift
        if [[ ${1:-} == --to ]]; then
            [[ -n ${2:-} ]] || die "$(t "--to requires a destination.")"
            err=$(set_dests "$2") || die "$err."
            set_dests "$2"
            shift 2
        else
            err=$(set_dests "") || die "$err."
            set_dests ""
        fi
    fi
    case $cmd in
    "")
        [[ -t 0 && -t 1 ]] || die "$(t "the menus need a terminal; see --help.")"
        TTY_STTY=$(stty -g </dev/tty 2>/dev/null)
        # dialogs drawn by the tool itself instead of whiptail
        if [[ ${PROXDUMP_UI:-$UI_STYLE} == native && -r $LIB_DIR/tui.sh ]]; then
            # shellcheck disable=SC1091
            source "$LIB_DIR/tui.sh"
            tui_enter
        fi
        kbd_hush
        main_menu
        ;;
    backup)
        (($#)) || die "$(t "specify --all or at least one ID.")"
        # a run started while another one is in progress waits for its turn
        LOCK_WAIT=43200
        if [[ $1 == --all ]]; then
            ids=$(guest_list | cut -f1 | tr '\n' ' ')
            [[ -n ${ids// /} ]] || die "$(t "no guests on this node.")"
        else
            ids="$*"
        fi
        # shellcheck disable=SC2086
        backup_guests $ids
        ;;
    list)
        for d in "${DESTS[@]}"; do
            use_dest "$d"
            ((${#DESTS[@]} > 1)) && echo "$DEST_NAME:"
            while IFS= read -r line; do
                backup_label "$line"
                echo
            done < <(remote_list)
        done
        ;;
    keepalive)
        # while another operation runs, the tokens are in use anyway
        acquire_lock >/dev/null || exit 0
        keepalive || exit 1
        ;;
    prune)
        acquire_lock || exit 1
        for d in "${DESTS[@]}"; do
            use_dest "$d"
            prune_remote
        done
        ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
}

main "$@"
