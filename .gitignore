# Nothing below must ever be committed: secrets and data.

# Configuration and secrets (OneDrive OAuth token, encryption passphrase)
rclone.conf
rclone.conf.*
*.conf.bak
/config
/etc/
.env
.env.*
*.token
*.key
*.pem

# Backup archives
*.vma
*.vma.*
*.tar.zst
*.tar.gz
*.tar.lzo
dump/

# Logs and temporary files
*.log
*.lock
*.tmp
proxdump.*/

# Local tooling
.claude/
__pycache__/
*.pyc
