#!/usr/bin/env bash
# onedrivepbs — encrypted backup of Proxmox VE VMs/containers to cloud storage
# (Microsoft OneDrive, Google Drive)
#
# Pipeline: vzdump (temporary local archive) -> rclone crypt -> destination(s)
# Interface: whiptail menus, or non-interactive subcommands (cron).
#
# MIT License — see LICENSE.

set -u
set -o pipefail

VERSION="1.0.0"
TITLE="onedrivepbs $VERSION"

CONF_DIR="${ONEDRIVEPBS_CONF_DIR:-/etc/onedrivepbs}"
CONF_FILE="$CONF_DIR/config"
LOG_FILE="${ONEDRIVEPBS_LOG:-/var/log/onedrivepbs.log}"
LOCK_FILE="${ONEDRIVEPBS_LOCK:-/run/lock/onedrivepbs.lock}"
CRON_FILE="${ONEDRIVEPBS_CRON:-/etc/cron.d/onedrivepbs}"
export RCLONE_CONFIG="$CONF_DIR/rclone.conf"

# --- Defaults (overridden by $CONF_FILE) ------------------------------------
REMOTE_DIR="pve-backups/$(hostname -s)"   # folder on each destination
STAGING_DIR="/var/lib/vz/dump"    # local staging folder (vzdump archives)
KEEP_DEFAULT=3                    # versions kept per guest (0 = all)
VZDUMP_MODE="snapshot"            # snapshot | suspend | stop
COMPRESS="zstd"                   # zstd | gzip | lzo | 0
BWLIMIT=""                        # rclone rate limit (e.g. 10M), empty = none
VERIFY=1                          # verify checksums after upload
declare -A KEEP_BY_ID=()          # per-guest retention: KEEP_BY_ID[100]=5

CLEANUP_DIRS=()

# --- Destinations ------------------------------------------------------------
# A destination is an rclone remote named after its id, with a "crypt" remote
# '<id>-crypt' layered on top. Supporting another repository starts here.
DEST_IDS=(onedrive gdrive)
declare -A DEST_NAMES=([onedrive]="OneDrive" [gdrive]="Google Drive")
declare -A DEST_TYPES=([onedrive]=onedrive [gdrive]=drive) # rclone backend
declare -A DEST_VENDORS=([onedrive]=Microsoft [gdrive]=Google)
DESTS=() # destinations of the backup being run

# Makes a destination the current one: every function below that reads,
# writes or deletes remote files works on it.
use_dest() {
    DEST=$1
    BASE_REMOTE=$1
    CRYPT_REMOTE="$1-crypt"
    DEST_NAME=${DEST_NAMES[$1]:-$1}
}
use_dest onedrive

# --- Helpers -----------------------------------------------------------------

log() {
    local line
    line="$(date '+%F %T') $*"
    echo "$line" >>"$LOG_FILE" 2>/dev/null
    echo "$*"
}

die() {
    log "ERROR: $*" >&2
    exit 1
}

cleanup() {
    local d
    for d in "${CLEANUP_DIRS[@]:-}"; do
        [[ -n $d && -d $d ]] && rm -rf -- "$d"
    done
}
trap cleanup EXIT
trap 'echo; log "Interrupted."; exit 130' INT TERM

load_config() {
    # shellcheck disable=SC1090
    [[ -r $CONF_FILE ]] && source "$CONF_FILE"
    # earlier versions saved the remote names; they now follow the destination
    use_dest onedrive
    return 0
}

save_config() {
    local v id
    install -d -m 700 "$CONF_DIR"
    {
        echo "# onedrivepbs — generated automatically, contains no secrets"
        for v in REMOTE_DIR STAGING_DIR KEEP_DEFAULT \
                 VZDUMP_MODE COMPRESS BWLIMIT VERIFY; do
            printf '%s=%q\n' "$v" "${!v}"
        done
        for id in "${!KEEP_BY_ID[@]}"; do
            printf 'KEEP_BY_ID[%s]=%q\n' "$id" "${KEEP_BY_ID[$id]}"
        done
    } >"$CONF_FILE.tmp"
    chmod 600 "$CONF_FILE.tmp"
    mv "$CONF_FILE.tmp" "$CONF_FILE"
}

check_deps() {
    local missing=() c
    for c in whiptail rclone jq vzdump pvesh qmrestore pct flock numfmt; do
        command -v "$c" >/dev/null || missing+=("$c")
    done
    ((${#missing[@]} == 0)) || die "missing commands: ${missing[*]} (run install.sh)"
}

LOCK_WAIT=0 # seconds to wait for a running operation (0 = give up at once)

acquire_lock() {
    exec 9>"$LOCK_FILE"
    flock -n 9 && return 0
    if ((LOCK_WAIT > 0)); then
        log "Another onedrivepbs operation is in progress; waiting for it to finish (up to $(human_duration "$LOCK_WAIT"))."
        flock -w "$LOCK_WAIT" 9 && return 0
    fi
    log "Another onedrivepbs operation is already in progress."
    return 1
}

release_lock() {
    flock -u 9 2>/dev/null
    exec 9>&-
}

has_remote() {
    rclone listremotes 2>/dev/null | grep -qxF "$1:"
}

is_ready() { # the current destination
    has_remote "$BASE_REMOTE" && has_remote "$CRYPT_REMOTE"
}

# Destinations that are connected and usable. TSV: id, label
dest_list() {
    local id remotes
    remotes=$(rclone listremotes 2>/dev/null)
    for id in "${DEST_IDS[@]}"; do
        grep -qxF "$id:" <<<"$remotes" && grep -qxF "$id-crypt:" <<<"$remotes" &&
            printf '%s\t%s\n' "$id" "${DEST_NAMES[$id]}"
    done
}

dest_ready() { # id
    dest_list | cut -f1 | grep -qxF -- "$1"
}

# 'onedrive,gdrive' -> 'OneDrive and Google Drive'; empty = whatever is configured
dest_label() {
    local id out=""
    [[ -n $1 ]] || { echo "every configured destination"; return; }
    for id in ${1//,/ }; do
        out+="${out:+ and }${DEST_NAMES[$id]:-$id}"
    done
    echo "$out"
}

# Fills DESTS from a comma-separated list (empty = every configured
# destination); fails with a message if one of them cannot be used.
set_dests() {
    local id
    DESTS=()
    if [[ -z $1 ]]; then
        mapfile -t DESTS < <(dest_list | cut -f1)
        ((${#DESTS[@]})) || { echo "no destination is configured"; return 1; }
        return 0
    fi
    for id in ${1//,/ }; do
        dest_ready "$id" || { echo "destination '$id' is unknown or not configured"; return 1; }
        DESTS+=("$id")
    done
}

human_size() {
    numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "$1"
}

human_ts() { # 2026_10_12-18_00_00 -> 2026-10-12 18:00
    local t=$1
    echo "${t:0:4}-${t:5:2}-${t:8:2} ${t:11:2}:${t:14:2}"
}

keep_for() {
    echo "${KEEP_BY_ID[$1]:-$KEEP_DEFAULT}"
}

# --- Progress display --------------------------------------------------------

human_duration() { # seconds -> 1h02m, 3m04s, 5s
    local s=${1%.*}
    [[ $s =~ ^[0-9]+$ ]] || { echo "-"; return; }
    if ((s >= 3600)); then
        printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
    elif ((s >= 60)); then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

# Redraws a one-line progress bar in place: [#####-----]  42%  details
progress_bar() { # percentage, details
    local pct=$1 cols width fill line
    cols=$(tput cols 2>/dev/null || echo 80)
    ((pct > 100)) && pct=100
    width=$((cols - 60)); ((width > 40)) && width=40; ((width < 10)) && width=10
    fill=$((pct * width / 100))
    printf -v line '[%s%s] %3d%%  %s' "$(printf '%*s' "$fill" '' | tr ' ' '#')" \
        "$(printf '%*s' $((width - fill)) '' | tr ' ' '-')" "$pct" "$2"
    printf '\r\033[K%s' "${line:0:cols-1}"
}

# Same line, for steps that report no percentage
progress_note() { printf '\r\033[K%s' "$1"; }
progress_end() { printf '\r\033[K'; }

# Runs a Proxmox command (vzdump, qmrestore, pct restore) and logs its output.
# On a terminal, its percentage lines become a progress bar; while it reports
# none (container archives), the size written so far to the given folder is shown.
run_logged() { # folder to watch (or ""), command…
    local dir=$1 line part="" rc bar=0 start=$SECONDS
    local re_dump='^INFO: +([0-9]+)% \(([^)]*)\) in ([^,]*)(, read: ([^,]*))?'
    local re_restore='^progress ([0-9]+)% \(read ([0-9]+) bytes, duration ([0-9]+) sec\)'
    shift
    if [[ ! -t 1 ]]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"
        return "${PIPESTATUS[0]}"
    fi
    "$@" 2>&1 | while :; do
        IFS= read -r -t 2 line
        rc=$?
        if ((rc > 128)); then # nothing new for 2 s
            part+=$line
            if ((!bar)) && [[ -n $dir ]]; then
                progress_note "  In progress: $(human_size "$(du -sb "$dir" 2>/dev/null | cut -f1)") written, $(human_duration $((SECONDS - start))) elapsed"
            fi
            continue
        fi
        line=$part$line
        part=""
        ((rc != 0)) && [[ -z $line ]] && break
        echo "$line" >>"$LOG_FILE"
        if [[ $line =~ $re_dump ]]; then
            bar=1
            progress_bar "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}  ${BASH_REMATCH[5]}  ${BASH_REMATCH[3]}"
        elif [[ $line =~ $re_restore ]]; then
            bar=1
            progress_bar "${BASH_REMATCH[1]}" "$(human_size "${BASH_REMATCH[2]}") read  $(human_duration "${BASH_REMATCH[3]}")"
        else
            bar=0
            progress_end
            echo "$line"
        fi
        ((rc != 0)) && break
    done
    rc=${PIPESTATUS[0]}
    progress_end
    return "$rc"
}

# rclone copy, with a progress bar on a terminal and sparse statistics under
# cron. On a terminal rclone logs in JSON: the statistics feed the bar, the
# other messages go to the log file.
rclone_copy() { # source, destination
    local opts=(--retries 5 --low-level-retries 20) kind a b c d rc
    [[ -n $BWLIMIT ]] && opts+=(--bwlimit "$BWLIMIT")
    if [[ ! -t 1 ]]; then
        rclone copy "$1" "$2" "${opts[@]}" --log-file "$LOG_FILE" --log-level INFO \
            --stats 5m --stats-one-line
        return
    fi
    rclone copy "$1" "$2" "${opts[@]}" --log-level INFO --use-json-log --stats 1s 2>&1 >/dev/null |
        jq --unbuffered -rR '
            (fromjson? // {msg: .}) as $l
            | if $l.stats then
                $l.stats | ["S", .bytes, .totalBytes, (.speed // 0 | floor), (.eta // "")]
              else
                ["L", ($l.level // "notice"), ($l.msg | gsub("[\\n\\t]"; " ")), ($l.object // ""), ""]
              end
            | map(tostring) | join("\u001f")' |
        while IFS=$'\x1f' read -r kind a b c d; do
            if [[ $kind == S ]]; then
                ((b > 0)) && progress_bar $((a * 100 / b)) \
                    "$(human_size "$a") / $(human_size "$b")  $(human_size "$c")/s  ETA $(human_duration "$d")"
            else
                echo "$(date '+%F %T') rclone $a: $b${c:+ ($c)}" >>"$LOG_FILE"
                if [[ $a == error ]]; then
                    progress_end
                    echo "rclone: $b${c:+ ($c)}"
                fi
            fi
        done
    rc=${PIPESTATUS[0]}
    progress_end
    return "$rc"
}

# --- Inventory ---------------------------------------------------------------

# Guests on the local node. TSV: vmid, type (qemu|lxc), name, status
# Read straight from /etc/pve: an order of magnitude faster than pvesh, which
# matters because the menus call this on every screen.
guest_list() {
    local dir f id type key name status
    dir="/etc/pve/nodes/$(hostname -s)"
    for f in "$dir"/qemu-server/*.conf "$dir"/lxc/*.conf; do
        [[ -f $f ]] || continue
        id=${f##*/}
        id=${id%.conf}
        status=stopped
        if [[ $f == */qemu-server/* ]]; then
            type=qemu key=name
            kill -0 "$(cat "/run/qemu-server/$id.pid" 2>/dev/null)" 2>/dev/null && status=running
        else
            type=lxc key=hostname
            [[ -d /sys/fs/cgroup/lxc/$id ]] && status=running
        fi
        # the first section only: what follows describes snapshots
        name=$(awk -v k="$key:" '/^\[/ { exit } $1 == k { print $2; exit }' "$f")
        printf '%s\t%s\t%s\t%s\n' "$id" "$type" "${name:--}" "$status"
    done | sort -n
}

# Backups stored on the current destination, newest first for each guest.
# TSV: vmid, timestamp, type, name, size (bytes), path
remote_list() {
    local json err
    err=$(mktemp)
    if ! json=$(rclone lsjson -R --files-only "$CRYPT_REMOTE:" 2>"$err"); then
        # folder not created yet = no backups, not an error
        if grep -q "directory not found" "$err"; then
            rm -f "$err"
            return 0
        fi
        cat "$err" >>"$LOG_FILE"
        rm -f "$err"
        return 1
    fi
    rm -f "$err"
    jq -r '
        .[]
        | select(.Name | test("^vzdump-(qemu|lxc)-[0-9]+-[0-9_]+-[0-9_]+\\.(vma|tar)(\\.(zst|gz|lzo))?$"))
        | (.Name | capture("^vzdump-(?<t>qemu|lxc)-(?<id>[0-9]+)-(?<ts>[0-9_]+-[0-9_]+)\\.")) as $m
        | [ $m.id, $m.ts, $m.t,
            (.Path | split("/") | if length > 1 then (.[0] | sub("^[0-9]+_"; "")) else "-" end),
            (.Size|tostring), .Path ]
        | @tsv' <<<"$json" | sort -t$'\t' -k1,1n -k2,2r
}

# Deletes a backup and its companion files (.log)
delete_backup() { # archive path on the remote
    local path=$1 dir file prefix
    dir=$(dirname "$path")
    [[ $dir == "." ]] && dir=""
    file=$(basename "$path")
    [[ $file =~ ^(vzdump-(qemu|lxc)-[0-9]+-[0-9_]+-[0-9_]+)\. ]] || return 1
    prefix=${BASH_REMATCH[1]}
    rclone delete "$CRYPT_REMOTE:$dir" --include "/$prefix.*" \
        --log-file "$LOG_FILE" --log-level INFO </dev/null
}

# Applies retention (to every guest, or to a single one if a vmid is given)
prune_remote() {
    local only=${1:-} id ts type name size path keep prev="" n=0 deleted=0
    while IFS=$'\t' read -r id ts type name size path; do
        [[ -n $only && $id != "$only" ]] && continue
        if [[ $id != "$prev" ]]; then
            prev=$id
            n=0
        fi
        n=$((n + 1))
        keep=$(keep_for "$id")
        ((keep > 0 && n > keep)) || continue
        log "Retention ($keep version(s) for $id): deleting $path"
        if delete_backup "$path"; then
            deleted=$((deleted + 1))
        else
            log "ERROR: could not delete $path"
        fi
    done < <(remote_list)
    ((deleted > 0)) && rclone rmdirs "$CRYPT_REMOTE:" --leave-root 2>>"$LOG_FILE"
    log "Retention: $deleted backup(s) deleted."
}

# --- Backup ------------------------------------------------------------------

backup_guest() { # vmid type name
    local id=$1 type=$2 name=$3 tmp archive safe dest rc d
    safe=$(tr -c 'A-Za-z0-9.-' '-' <<<"$name" | sed 's/-*$//')
    dest="${id}_${safe:-guest}"

    [[ -d $STAGING_DIR && -w $STAGING_DIR ]] ||
        { log "ERROR: staging folder $STAGING_DIR is not usable"; return 1; }
    tmp=$(mktemp -d "$STAGING_DIR/onedrivepbs.XXXXXX") || return 1
    CLEANUP_DIRS+=("$tmp")
    # an unprivileged container is archived by a shifted uid, which must be
    # able to traverse the folder (without being able to list its contents)
    chmod 711 "$tmp"

    log "=== Backing up $type $id ($name) ==="
    run_logged "$tmp" vzdump "$id" --dumpdir "$tmp" --mode "$VZDUMP_MODE" --compress "$COMPRESS"
    rc=$?
    archive=$(find "$tmp" -maxdepth 1 -type f \( -name 'vzdump-*.vma*' -o -name 'vzdump-*.tar*' \) | head -n1)
    if ((rc != 0)) || [[ -z $archive ]]; then
        log "ERROR: vzdump failed for $id (exit code $rc)"
        rm -rf -- "$tmp"
        return 1
    fi

    # one archive, uploaded to each destination in turn
    for d in "${DESTS[@]}"; do
        use_dest "$d"
        log "Encrypted upload of $(basename "$archive") ($(human_size "$(stat -c %s "$archive")")) to $DEST_NAME…"
        if ! rclone_copy "$tmp" "$CRYPT_REMOTE:$dest"; then
            log "ERROR: upload to $DEST_NAME failed for $id"
            rc=1
            continue
        fi
        if [[ $VERIFY == 1 ]]; then
            log "Verifying checksums (re-reads the local archive, no progress shown)…"
            if ! rclone cryptcheck "$tmp" "$CRYPT_REMOTE:$dest" --one-way \
                --log-file "$LOG_FILE" --log-level NOTICE; then
                log "ERROR: verification failed for $id — the copy on $DEST_NAME cannot be trusted"
                rc=1
                continue
            fi
        fi
        log "Backup of $id to $DEST_NAME complete."
        prune_remote "$id"
    done
    rm -rf -- "$tmp"
    return "$rc"
}

# Backs up a list of guests to the destinations in DESTS;
# exit status = number of failures
backup_guests() { # vmid…
    local id type name status failed=0 found guests
    ((${#DESTS[@]})) || { log "ERROR: no destination is configured"; return 1; }
    for id in "${DESTS[@]}"; do
        dest_ready "$id" || { log "ERROR: destination '$id' is not configured"; return 1; }
    done
    acquire_lock || return 1
    guests=$(guest_list)
    for id in "$@"; do
        found=0
        while IFS=$'\t' read -r gid type name status; do
            if [[ $gid == "$id" ]]; then
                found=1
                backup_guest "$id" "$type" "$name" </dev/null || failed=$((failed + 1))
                break
            fi
        done <<<"$guests"
        ((found)) || { log "ERROR: guest $id not found on this node"; failed=$((failed + 1)); }
    done
    release_lock
    log "Done: $(($# - failed))/$# backup(s) succeeded."
    return "$failed"
}

# --- whiptail interface ------------------------------------------------------

dims() {
    local rows cols
    read -r rows cols < <(stty size 2>/dev/null || echo "24 80")
    H=$((rows - 4)); ((H > 30)) && H=30; ((H < 16)) && H=16
    W=$((cols - 6)); ((W > 100)) && W=100; ((W < 60)) && W=60
    LH=$((H - 9))
}

# Dialogs are sized to their contents instead of filling the screen
text_lines() { # text -> TL, the number of lines it takes at width W
    local text=${1//\\n/$'\n'} line
    TL=0
    while IFS= read -r line; do
        TL=$((TL + 1 + ${#line} / (W - 4)))
    done <<<"$text"
}
box_dims() { # text, extra lines (input field)
    dims
    text_lines "$1"
    ((TL + 6 + ${2:-0} < H)) && H=$((TL + 6 + ${2:-0}))
}
list_dims() { # text, number of entries
    dims
    text_lines "$1"
    LH=$2
    ((LH > H - TL - 7)) && LH=$((H - TL - 7))
    ((LH < 3)) && LH=3
    H=$((LH + TL + 7))
}

msg() { box_dims "$1"; whiptail --title "$TITLE" --msgbox "$1" "$H" "$W"; }
confirm() { box_dims "$1"; whiptail --title "$TITLE" --yesno "$1" "$H" "$W"; }
confirm_no() { box_dims "$1"; whiptail --title "$TITLE" --defaultno --yesno "$1" "$H" "$W"; }
input() { box_dims "$1" 2; whiptail --title "$TITLE" --inputbox "$1" "$H" "$W" "${2:-}" 3>&1 1>&2 2>&3; }
password() { box_dims "$1" 2; whiptail --title "$TITLE" --passwordbox "$1" "$H" "$W" 3>&1 1>&2 2>&3; }
# A text that fits is closed with Enter; a scrolling one keeps the keyboard
# focus on the text, hence the reminder in its title.
textbox() { # title, file
    local title=$1 opts=()
    dims
    if (($(wc -l <"$2") + 6 <= H)); then
        H=$(($(wc -l <"$2") + 6))
    else
        opts=(--scrolltext)
        title+=" (Tab, then Enter, to close)"
    fi
    whiptail --title "$title" "${opts[@]}" --textbox "$2" "$H" "$W"
}
# The second button reads "Cancel" unless CANCEL is set (Quit, Back)
menu() { # text, then tag/label pairs
    local text=$1
    shift
    list_dims "$text" $(($# / 2))
    whiptail --title "$TITLE" --cancel-button "${CANCEL:-Cancel}" \
        --menu "$text" "$H" "$W" "$LH" "$@" 3>&1 1>&2 2>&3
}
checklist() { # text, then tag/label/state triplets
    local text=$1
    shift
    list_dims "$text" $(($# / 3))
    whiptail --title "$TITLE" --separate-output --checklist "$text" "$H" "$W" "$LH" "$@" 3>&1 1>&2 2>&3
}

# Between two dialogs the terminal shows whatever was printed last. These two
# keep it clean: nothing from a previous operation is ever left behind.
screen() { # heading of the operation about to run
    clear
    printf '\033[1m%s — %s\033[0m\n\n' "$TITLE" "$1"
}
busy() { # one-line notice shown while a dialog is being prepared
    clear
    printf '\n  %s\n' "$1"
}
pause() {
    echo
    read -rp "Press Enter to return to the menu. " _
    clear
}

need_ready() {
    is_ready && return 0
    msg "A destination and the encryption must be configured before this function can be used.\n\nPlease complete the 'Configuration' menu first."
    return 1
}

# Makes one of the configured destinations the current one; the question is
# skipped when there is only one.
pick_dest() {
    local items=() id label
    while IFS=$'\t' read -r id label; do
        items+=("$id" "$label")
    done < <(dest_list)
    case ${#items[@]} in
    0) need_ready; return 1 ;;
    2) id=${items[0]} ;;
    *) id=$(menu "Select the destination:" "${items[@]}") || return 1 ;;
    esac
    use_dest "$id"
}

# Same, for a backup: several destinations may be selected (into DESTS)
pick_dests() {
    local items=() id label sel
    while IFS=$'\t' read -r id label; do
        items+=("$id" "$label" ON)
    done < <(dest_list)
    DESTS=()
    case ${#items[@]} in
    0) need_ready; return 1 ;;
    3) DESTS=("${items[0]}") ;;
    *)
        sel=$(checklist "Select the destinations of the backup (Space to select, Enter to confirm).\n\nThe archive is created once, then uploaded to each of them." "${items[@]}") || return 1
        [[ -n $sel ]] || { msg "No destination was selected."; return 1; }
        mapfile -t DESTS <<<"$sel"
        ;;
    esac
}

# Loads the remote listing into the BACKUPS array (one TSV line per entry)
load_backups() {
    local out
    busy "Reading the list of backups from $DEST_NAME…"
    if ! out=$(remote_list); then
        msg "The list of backups could not be read from $DEST_NAME.\n\nPlease verify the connection (Configuration > Test the connections)."
        return 1
    fi
    BACKUPS=()
    [[ -n $out ]] && mapfile -t BACKUPS <<<"$out"
    return 0
}

backup_label() { # TSV line -> readable label
    local id ts type name size path
    IFS=$'\t' read -r id ts type name size path <<<"$1"
    printf '%-5s %-4s %-18.18s %s %9s' "$id" "$type" "$name" "$(human_ts "$ts")" "$(human_size "$size")"
}

ui_backup() {
    pick_dests || return
    local items=() id type name status sel free
    while IFS=$'\t' read -r id type name status; do
        [[ -n $id ]] && items+=("$id" "$(printf '%-4s %-22.22s %s' "$type" "$name" "$status")" OFF)
    done < <(guest_list)
    ((${#items[@]})) || { msg "No virtual machine or container was found on this node."; return; }
    free=$(df -h --output=avail "$STAGING_DIR" 2>/dev/null | tail -n1 | tr -d ' ')
    sel=$(checklist "Select the guests to back up (Space to select, Enter to confirm).\n\nStaging folder: $STAGING_DIR (${free:-?} free)\nMode: $VZDUMP_MODE — compression: $COMPRESS — default retention: $KEEP_DEFAULT" "${items[@]}") || return
    [[ -n $sel ]] || return
    screen "Backup"
    # shellcheck disable=SC2086
    backup_guests $sel
    pause
}

ui_list() {
    need_ready || return
    load_backups || return
    ((${#BACKUPS[@]})) || { msg "No backup was found on $DEST_NAME."; return; }
    local tmp line total=0 size
    tmp=$(mktemp)
    {
        printf '%-5s %-4s %-18s %-16s %9s\n' ID TYPE NAME DATE SIZE
        for line in "${BACKUPS[@]}"; do
            backup_label "$line"
            echo
            size=$(cut -f5 <<<"$line")
            total=$((total + size))
        done
        echo
        echo "${#BACKUPS[@]} backup(s), $(human_size "$total") in total (size before encryption)"
    } >"$tmp"
    textbox "$TITLE — backups on $DEST_NAME" "$tmp"
    rm -f "$tmp"
}

ui_delete() {
    need_ready || return
    load_backups || return
    ((${#BACKUPS[@]})) || { msg "No backup was found on $DEST_NAME."; return; }
    local items=() i sel n=0
    for i in "${!BACKUPS[@]}"; do
        items+=("$i" "$(backup_label "${BACKUPS[$i]}")" OFF)
    done
    sel=$(checklist "Select the backups to delete from $DEST_NAME (Space to select, Enter to confirm)." "${items[@]}") || return
    [[ -n $sel ]] || return
    n=$(wc -l <<<"$sel")
    confirm_no "Delete $n backup(s) from $DEST_NAME?\n\nDeleted files remain in the recycle bin of the account, still encrypted, until it is emptied." || return
    screen "Deletion"
    acquire_lock || { pause; return; }
    for i in $sel; do
        log "Deleting $(cut -f6 <<<"${BACKUPS[$i]}")"
        delete_backup "$(cut -f6 <<<"${BACKUPS[$i]}")" || log "ERROR: deletion failed"
    done
    rclone rmdirs "$CRYPT_REMOTE:" --leave-root 2>>"$LOG_FILE"
    release_lock
    pause
}

valid_count() { [[ $1 =~ ^[0-9]+$ ]]; }

ui_retention() {
    local choice v id items type name status
    while :; do
        choice=$(CANCEL=Back menu "Number of versions retained for each guest.\nA value of 0 retains every version (no pruning)." \
            D "Default value: $KEEP_DEFAULT" \
            G "Value per guest (${#KEEP_BY_ID[@]} defined)") || return
        case $choice in
        D)
            v=$(input "Number of versions retained by default (0 = retain every version):" "$KEEP_DEFAULT") || continue
            valid_count "$v" || { msg "The value entered is not valid."; continue; }
            KEEP_DEFAULT=$v
            save_config
            ;;
        G)
            items=()
            while IFS=$'\t' read -r id type name status; do
                [[ -n $id ]] && items+=("$id" "$(printf '%-22.22s retains: %s' "$name" "${KEEP_BY_ID[$id]:-default ($KEEP_DEFAULT)}")")
            done < <(guest_list)
            # guests gone from the node that still have a setting
            for id in "${!KEEP_BY_ID[@]}"; do
                [[ " ${items[*]} " == *" $id "* ]] || items+=("$id" "(not on this node) retains: ${KEEP_BY_ID[$id]}")
            done
            ((${#items[@]})) || { msg "No guest was found."; continue; }
            id=$(menu "Select the guest:" "${items[@]}") || continue
            v=$(input "Number of versions retained for guest $id\n(empty = default value, 0 = retain every version):" "${KEEP_BY_ID[$id]:-}") || continue
            if [[ -z $v ]]; then
                unset "KEEP_BY_ID[$id]"
            elif valid_count "$v"; then
                KEEP_BY_ID[$id]=$v
            else
                msg "The value entered is not valid."
                continue
            fi
            save_config
            ;;
        esac
    done
}

ui_prune() {
    need_ready || return
    confirm_no "Apply the retention policy now?\n\nFor each guest, the backups in excess of the configured number of versions will be deleted from $DEST_NAME, oldest first." || return
    screen "Retention"
    acquire_lock || { pause; return; }
    prune_remote
    release_lock
    pause
}

ui_about() {
    need_ready || return
    local out
    busy "Querying the $DEST_NAME account…"
    out=$(rclone about "$BASE_REMOTE:" 2>&1)
    msg "Storage of the $DEST_NAME account:\n\n$out"
}

ui_manage() {
    local choice
    pick_dest || return
    while :; do
        choice=$(CANCEL=Back menu "Management of the backups stored on $DEST_NAME" \
            L "List the backups" \
            D "Delete backups" \
            V "Retention policy" \
            P "Apply the retention policy now" \
            S "Storage used on $DEST_NAME") || return
        case $choice in
        L) ui_list ;;
        D) ui_delete ;;
        V) ui_retention ;;
        P) ui_prune ;;
        S) ui_about ;;
        esac
    done
}

# --- Restore -----------------------------------------------------------------

guest_exists() {
    compgen -G "/etc/pve/nodes/*/qemu-server/$1.conf" >/dev/null ||
        compgen -G "/etc/pve/nodes/*/lxc/$1.conf" >/dev/null
}

pick_storage() { # guest type -> storage name
    local content=images items=() name stype status avail
    [[ $1 == lxc ]] && content=rootdir
    while read -r name stype status _ _ avail _; do
        [[ $status == active ]] && items+=("$name" "$(printf '%-8s %s free' "$stype" "$(human_size $((avail * 1024)))")")
    done < <(pvesm status --content "$content" 2>/dev/null | tail -n +2)
    ((${#items[@]})) || { msg "No active storage accepts this type of disk."; return 1; }
    menu "Select the target storage for the disks:" "${items[@]}"
}

ui_restore() {
    pick_dest || return
    load_backups || return
    ((${#BACKUPS[@]})) || { msg "No backup was found on $DEST_NAME."; return; }
    local items=() i sel id ts type name size path action target storage tmp file rc
    local force=() unique=() free
    for i in "${!BACKUPS[@]}"; do
        items+=("$i" "$(backup_label "${BACKUPS[$i]}")")
    done
    sel=$(menu "Select the backup to restore:" "${items[@]}") || return
    IFS=$'\t' read -r id ts type name size path <<<"${BACKUPS[$sel]}"

    action=$(menu "Backup: $type $id ($name) from $(human_ts "$ts"), $(human_size "$size")" \
        O "Restore under the original ID ($id)" \
        N "Restore under a new ID (as a copy)" \
        D "Download the decrypted archive without restoring it") || return

    case $action in
    O)
        target=$id
        if guest_exists "$target"; then
            confirm_no "Warning: guest $target already exists.\n\nThe restore will overwrite its configuration and its disks. The guest must be stopped beforehand.\n\nDo you wish to continue?" || return
            force=(--force 1)
        fi
        ;;
    N)
        target=$(input "New ID:" "$(pvesh get /cluster/nextid 2>/dev/null)") || return
        [[ $target =~ ^[0-9]+$ ]] || { msg "The ID entered is not valid."; return; }
        guest_exists "$target" && { msg "ID $target is already in use."; return; }
        confirm "Generate new MAC addresses?\n\nThis is recommended when the original guest remains in service." && unique=(--unique 1)
        ;;
    D)
        target=$(input "Destination folder:" "$STAGING_DIR") || return
        [[ -d $target && -w $target ]] || { msg "The folder does not exist or is not writable."; return; }
        screen "Download"
        acquire_lock || { pause; return; }
        log "Downloading $path to $target"
        rclone_copy "$CRYPT_REMOTE:$path" "$target" &&
            log "Archive available: $target/$(basename "$path")"
        release_lock
        pause
        return
        ;;
    esac

    storage=$(pick_storage "$type") || return
    free=$(df --output=avail -B1 "$STAGING_DIR" 2>/dev/null | tail -n1 | tr -d ' ')
    if [[ -n $free ]] && ((free < size)); then
        msg "There is not enough space in $STAGING_DIR to download the archive ($(human_size "$size") required, $(human_size "$free") available).\n\nPlease select another staging folder in the Configuration menu."
        return
    fi

    screen "Restore"
    acquire_lock || { pause; return; }
    tmp=$(mktemp -d "$STAGING_DIR/onedrivepbs.XXXXXX") || { release_lock; pause; return; }
    CLEANUP_DIRS+=("$tmp")
    log "=== Restoring $path to $type $target (storage $storage) ==="
    if rclone_copy "$CRYPT_REMOTE:$path" "$tmp"; then
        file="$tmp/$(basename "$path")"
        if [[ $type == qemu ]]; then
            run_logged "" qmrestore "$file" "$target" --storage "$storage" "${force[@]}" "${unique[@]}"
        else
            run_logged "" pct restore "$target" "$file" --storage "$storage" "${force[@]}" "${unique[@]}"
        fi
        rc=$?
        if ((rc == 0)); then
            log "Restore complete: $type $target."
        else
            log "ERROR: restore failed (exit code $rc)."
        fi
    else
        log "ERROR: download from $DEST_NAME failed."
    fi
    rm -rf -- "$tmp"
    release_lock
    pause
}

# --- Configuration -----------------------------------------------------------

# Cleans up a pasted token: line breaks and spaces added by the terminal,
# '--->' and '<---End paste' markers copied by mistake
clean_token() {
    local t
    t=$(tr -d '[:space:]' <<<"$1")
    [[ $t == *'--->'* ]] && t=${t##*--->}
    t=${t%%<---*}
    printf '%s' "$t"
}

# True if the token is complete (rclone JSON, or its base64-encoded variant)
token_ok() {
    jq -e '.access_token | strings | length > 0' <<<"$1" >/dev/null 2>&1 ||
        base64 -d <<<"$1" 2>/dev/null | jq -e 'type == "object"' >/dev/null 2>&1
}

# Reads the token from the keyboard; a paste split over several lines is rejoined
read_token() {
    local buf="" line prompt="Token > "
    while read -e -r -p "$prompt" line; do
        if [[ -z $buf && -n $line && -f $line ]]; then
            buf=$(<"$line")
            break
        fi
        [[ -z $line ]] && break
        buf+=$line
        token_ok "$(clean_token "$buf")" && break
        prompt="  (continue pasting, or press Enter to finish) > "
    done
    # leftovers of the paste, if any ('<---End paste'…)
    while read -r -s -t 0.3 line; do :; done
    clean_token "$buf"
}

# Drive choice: rclone also lists Microsoft's technical drives (metadata
# archives, 'bundles', raw identifiers) that are of no use here.
# If only one real drive is left, it is picked automatically.
pick_drive() { # rclone's JSON answer
    local out=$1 n i name items=() real=()
    local junk='^(ODCMetadataArchive|Bundles_[0-9a-f]+|[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}) '
    n=$(jq -r '.Option.Examples | length' <<<"$out")
    for ((i = 0; i < n; i++)); do
        name=$(jq -r ".Option.Examples[$i].Help" <<<"$out" | head -n1 | cut -c1-70)
        items+=("$i" "$name")
        [[ $name =~ $junk ]] || real+=("$i" "$name")
    done
    if ((${#real[@]} == 2)); then
        i=${real[0]}
    else
        ((${#real[@]} > 2)) && items=("${real[@]}")
        i=$(menu "Select the drive to use:" "${items[@]}") || return 1
    fi
    jq -r ".Option.Examples[$i].Value" <<<"$out"
}

# Google Drive is reached through an OAuth client that belongs to the user.
# Explains how to create one and reads its two values, which stay on screen
# next to the instructions (into GD_CLIENT_ID and GD_CLIENT_SECRET).
gdrive_client() {
    screen "Google Drive: OAuth client"
    cat <<EOF
Google Drive is accessed through an "OAuth client" that you create, free of
charge, in the Google Cloud console. This is done once, in a web browser on
any computer; the two values it produces are then entered below.

1. Open https://console.cloud.google.com/ and sign in to a Google account.
   Create a project: "Select a project" > "New project" (any name).
2. Menu "APIs & Services" > "Library": search for "Google Drive API", open
   it and click "Enable".
3. Menu "APIs & Services" > "OAuth consent screen" > "Get started": enter an
   application name (for instance rclone) and your e-mail address, choose
   the audience "External", accept the terms and click "Create".
4. "Data Access" > "Add or remove scopes": tick the scope ending in
   /auth/drive, then "Update" and "Save".
5. "Branding": fill in "Application home page" and "Application privacy
   policy link" with addresses of a domain of yours (for instance
   https://example.org and https://example.org/privacy), add that domain
   under "Authorized domains", then "Save". Google may then report that
   the branding could not be verified: ignore it, no verification is needed.
6. "Audience" > "Publish app" > "Confirm". Once published, the application
   needs no test users, and the authorization does not expire after 7 days.
7. "Clients" > "Create client": application type "Desktop app", then
   "Create". Google displays the client ID and the client secret.

Press Enter on an empty line to cancel.

EOF
    while :; do
        read -e -r -p "Client ID > " GD_CLIENT_ID || return 1
        GD_CLIENT_ID=$(tr -d '[:space:]' <<<"$GD_CLIENT_ID")
        [[ -n $GD_CLIENT_ID ]] || return 1
        [[ $GD_CLIENT_ID == *.apps.googleusercontent.com ]] && break
        echo "A client ID ends with '.apps.googleusercontent.com'. Please enter it again."
    done
    read -e -r -p "Client secret > " GD_CLIENT_SECRET || return 1
    GD_CLIENT_SECRET=$(tr -d '[:space:]' <<<"$GD_CLIENT_SECRET")
    [[ -n $GD_CLIENT_SECRET ]]
}

# Drives rclone's configuration wizard, one question at a time, for the
# current destination
remote_wizard() {
    local out err bak state qname help def result n i items token args=()
    if [[ $DEST == gdrive ]]; then
        gdrive_client || return 1
        args=(scope=drive client_id="$GD_CLIENT_ID" client_secret="$GD_CLIENT_SECRET")
    fi
    err=$(mktemp)
    bak=$(mktemp)
    [[ -f $RCLONE_CONFIG ]] && cp -p "$RCLONE_CONFIG" "$bak"
    # on cancel or error, the previous configuration is put back
    wizard_abort() {
        if [[ -s $bak ]]; then cp -p "$bak" "$RCLONE_CONFIG"; else rclone config delete "$BASE_REMOTE" 2>/dev/null; fi
        rm -f "$err" "$bak"
        return 1
    }
    rclone config delete "$BASE_REMOTE" 2>/dev/null
    out=$(rclone config create "$BASE_REMOTE" "${DEST_TYPES[$DEST]}" config_is_local=false "${args[@]}" --non-interactive 2>"$err")
    while :; do
        state=$(jq -r '.State // ""' <<<"$out" 2>/dev/null)
        if [[ -z $out || $(jq -r '.Error // ""' <<<"$out" 2>/dev/null) != "" ]]; then
            msg "rclone reported an error:\n\n$(jq -r '.Error // ""' <<<"$out" 2>/dev/null)\n$(grep -i 'error' "$err" | tail -n 3)"
            [[ -z $state ]] && { wizard_abort; return 1; }
        fi
        [[ -z $state ]] && break
        qname=$(jq -r '.Option.Name' <<<"$out")
        help=$(jq -r '.Option.Help' <<<"$out")
        def=$(jq -r '.Option.DefaultStr // ""' <<<"$out")
        n=$(jq -r '.Option.Examples | length' <<<"$out")

        if [[ $qname == config_token ]]; then
            screen "$DEST_NAME authorization"
            cat <<EOF
This server has no web browser: access is authorized once, from another
computer, and the resulting token is pasted here.

1. On a computer equipped with a web browser, install rclone
   (https://rclone.org/downloads/), preferably the version used by this
   server: $(rclone version 2>/dev/null | head -n1).

2. On that computer, open a terminal and run, exactly as shown:

       $(grep -o 'rclone authorize .*' <<<"$help" | head -n1)

3. The browser opens the ${DEST_VENDORS[$DEST]} sign-in page. Sign in with the account
   that will hold the backups, then accept the access requested by rclone.
   The browser confirms with "Success!".

4. Back in the terminal of that computer, rclone displays the token between
   two markers:

       Paste the following into your remote machine --->
       {"access_token":"…","refresh_token":"…","expiry":"…"}
       <---End paste

   Copy everything between the markers and paste it below. Line breaks are
   accepted. Alternatively, save it to a file on this server and enter the
   path of that file.

The token grants access to the files of the account: treat it as a password.
Press Enter on an empty line to cancel.

EOF
            while :; do
                token=$(read_token)
                [[ -n $token ]] || { wizard_abort; return 1; }
                token_ok "$token" && break
                echo
                echo "The token is incomplete or invalid (${#token} characters received): it must begin"
                echo "with '{' and end with '}'. Please paste it again in full, or press Enter to cancel."
                echo
            done
            result=$token
        elif [[ $qname == config_driveid ]] && ((n > 0)); then
            result=$(pick_drive "$out") || { wizard_abort; return 1; }
        elif [[ $qname == config_drive_ok ]]; then
            # rclone's final confirmation: the drive found, its type and its URL
            if confirm "Use the following drive?\n\n$(sed '1d;/./,$!d' <<<"$help")"; then result=true; else result=false; fi
        elif [[ $(jq -r '.Option.Type' <<<"$out") == bool ]]; then
            # the default answer is rclone's own
            if [[ $def == true ]]; then
                if confirm "$help"; then result=true; else result=false; fi
            else
                if confirm_no "$help"; then result=true; else result=false; fi
            fi
        elif ((n > 0)); then
            items=()
            for ((i = 0; i < n; i++)); do
                items+=("$(jq -r ".Option.Examples[$i].Value" <<<"$out")" "$(jq -r ".Option.Examples[$i].Help" <<<"$out" | head -n1 | cut -c1-70)")
            done
            result=$(menu "$help" "${items[@]}") || { wizard_abort; return 1; }
        else
            result=$(input "$help" "$def") || { wizard_abort; return 1; }
        fi
        out=$(rclone config update "$BASE_REMOTE" --continue --state "$state" --result "$result" --non-interactive 2>"$err")
    done
    rm -f "$err" "$bak"
    chmod 600 "$RCLONE_CONFIG" 2>/dev/null
    return 0
}

# Deletes the token stored on this server. The authorization itself can only
# be withdrawn on the provider's side: the user is told where.
ui_remove_remote() {
    local n note="" where
    load_schedules
    n=${#SCHEDULES[@]}
    ((n)) && note="\n\n$n schedule(s) are defined: those that use $DEST_NAME will fail until a connection is configured again."
    confirm_no "Remove the $DEST_NAME connection from this server?\n\nThe access token stored in $RCLONE_CONFIG will be deleted. The backups on $DEST_NAME and the encryption passphrase are kept.$note\n\nDo you wish to continue?" || return
    rclone config delete "$BASE_REMOTE" 2>>"$LOG_FILE"
    if has_remote "$BASE_REMOTE"; then
        msg "The $DEST_NAME connection could not be removed. Please consult the log."
        return
    fi
    log "$DEST_NAME connection removed from this server." >/dev/null
    case $DEST in
    onedrive) where="  Personal account:\n    https://account.microsoft.com/privacy/app-access\n\n  Work or school account:\n    https://myapps.microsoft.com" ;;
    gdrive) where="  https://myaccount.google.com/connections" ;;
    esac
    msg "The $DEST_NAME connection has been removed from this server.\n\nThe authorization granted to rclone remains registered with ${DEST_VENDORS[$DEST]}. To withdraw it as well, sign in to the account and remove the application from the list of authorized applications:\n\n$where"
}

ui_setup_remote() { # for the current destination
    local choice
    if has_remote "$BASE_REMOTE"; then
        choice=$(CANCEL=Back menu "A $DEST_NAME connection is configured.\n\nReplacing or removing it does not affect the backups already uploaded." \
            R "Replace the connection (sign in again, or use another account)" \
            D "Remove the connection from this server") || return
        [[ $choice == D ]] && { ui_remove_remote; return; }
    fi
    choice=$(menu "Select the method used to connect to $DEST_NAME:" \
        G "Guided configuration (recommended)" \
        M "Manual rclone configuration (special cases)") || return
    install -d -m 700 "$CONF_DIR"
    case $choice in
    G)
        remote_wizard || { msg "The $DEST_NAME connection was not completed. The previous configuration, if any, is unchanged."; return; }
        ;;
    M)
        msg "The 'rclone config' tool will now open.\n\nCreate (n) a remote named exactly:\n\n    $BASE_REMOTE\n\nof type '${DEST_TYPES[$DEST]}', then quit (q)."
        screen "Manual rclone configuration"
        rclone config
        chmod 600 "$RCLONE_CONFIG" 2>/dev/null
        ;;
    esac
    ensure_crypt
    ui_test
}

ui_test() {
    local out
    has_remote "$BASE_REMOTE" || { msg "The $DEST_NAME connection is not configured."; return 1; }
    busy "Testing the $DEST_NAME connection…"
    if out=$(rclone about "$BASE_REMOTE:" 2>&1); then
        msg "The $DEST_NAME connection is operational.\n\n$out"
    else
        msg "The $DEST_NAME connection failed:\n\n$(tail -n 8 <<<"$out")"
        return 1
    fi
}

# rclone crypt always encrypts the contents (XSalsa20-Poly1305, 256-bit key).
# File and folder names are kept as they are, with an '.encrypted' suffix.
CRYPT_NAMES=$'filename_encryption = off\ndirectory_name_encryption = false\nsuffix = .encrypted'

# True if the crypt remote already stores plain names with the suffix
names_plain() {
    rclone config dump 2>/dev/null | jq -e --arg n "$CRYPT_REMOTE" \
        '.[$n] | .filename_encryption == "off" and .suffix == ".encrypted"' >/dev/null
}

# The passphrase is shared by every destination: the first crypt remote
# found provides it.
obscured_passphrase() {
    rclone config dump 2>/dev/null | jq -r --args '
        [ $ARGS.positional[] as $id | .[$id + "-crypt"].password // empty ] | first // empty' \
        "${DEST_IDS[@]}"
}

current_passphrase() {
    local obscured
    obscured=$(obscured_passphrase)
    [[ -n $obscured ]] && rclone reveal "$obscured"
}

# Writes the crypt section straight into rclone.conf, so the passphrase never
# appears on a command line visible in 'ps'.
write_crypt_section() { # obscured passphrase, destinations (default: all)
    local obscured=$1 id
    shift
    (($#)) || set -- "${DEST_IDS[@]}"
    install -d -m 700 "$CONF_DIR"
    touch "$RCLONE_CONFIG"
    chmod 600 "$RCLONE_CONFIG"
    for id; do
        rclone config delete "$id-crypt" 2>/dev/null
        printf '\n[%s]\ntype = crypt\nremote = %s:%s\npassword = %s\n%s\n' \
            "$id-crypt" "$id" "$REMOTE_DIR" "$obscured" "$CRYPT_NAMES" >>"$RCLONE_CONFIG"
    done
}

# Gives every destination its crypt remote once a passphrase exists (a
# destination added by a newer version, or connected after the encryption
# was configured).
ensure_crypt() {
    local obscured id remotes missing=()
    remotes=$(rclone listremotes 2>/dev/null)
    for id in "${DEST_IDS[@]}"; do
        grep -qxF "$id-crypt:" <<<"$remotes" || missing+=("$id")
    done
    ((${#missing[@]})) || return 0
    obscured=$(obscured_passphrase)
    [[ -n $obscured ]] || return 0
    write_crypt_section "$obscured" "${missing[@]}"
}

write_crypt_remote() { # passphrase
    local obscured
    obscured=$(printf '%s\n' "$1" | rclone obscure -) || return 1
    write_crypt_section "$obscured"
}

# Earlier versions could encrypt or scramble the names. This converts such an
# installation: the contents are encrypted the same way whatever the naming,
# so the backups already uploaded are only renamed there (nothing is
# uploaded again).
migrate_names() {
    local obscured json err base="$BASE_REMOTE:$REMOTE_DIR" path old enc n=0 failed=0
    obscured=$(obscured_passphrase)
    [[ -n $obscured ]] || return 1
    err=$(mktemp)
    if ! json=$(rclone lsjson -R --files-only --encrypted "$CRYPT_REMOTE:" 2>"$err"); then
        if grep -q "directory not found" "$err"; then
            json='[]'
        else
            cat "$err" >>"$LOG_FILE"
            rm -f "$err"
            log "ERROR: $DEST_NAME could not be read; the file names were left unchanged"
            return 1
        fi
    fi
    rm -f "$err"
    write_crypt_section "$obscured" "$DEST" || return 1
    while IFS=$'\t' read -r path old; do
        [[ -n $path ]] || continue
        enc=$(rclone cryptdecode --reverse "$CRYPT_REMOTE:" "$path" 2>>"$LOG_FILE" </dev/null |
            awk -F' \t ' '{print $2}')
        [[ -n $enc ]] || { log "ERROR: no new name for $path"; failed=$((failed + 1)); continue; }
        [[ $enc == "$old" ]] && continue
        log "Renaming $path"
        if rclone moveto "$base/$old" "$base/$enc" --log-file "$LOG_FILE" --log-level NOTICE </dev/null; then
            n=$((n + 1))
        else
            log "ERROR: $path could not be renamed (still stored as $old)"
            failed=$((failed + 1))
        fi
    done < <(jq -r '.[] | [.Path, .EncryptedPath] | @tsv' <<<"$json")
    rclone rmdirs "$base" --leave-root 2>>"$LOG_FILE"
    log "File names converted: $n file(s) renamed, $failed failure(s)."
    return "$failed"
}

ui_migrate_names() {
    confirm "The backups on $DEST_NAME are stored under encrypted file names, as produced by an earlier version.\n\nThis version stores them under their original names followed by '.encrypted'. The existing backups can be renamed accordingly; their contents remain encrypted and nothing is uploaded again.\n\nDo you wish to convert them now?" || return
    screen "Conversion of the file names"
    acquire_lock || { pause; return; }
    migrate_names
    release_lock
    pause
}

ui_setup_crypt() {
    local choice p1 p2
    if [[ -n $(obscured_passphrase) ]]; then
        choice=$(CANCEL=Back menu "Encryption is configured. The same passphrase is used for every destination.\n\nThe contents of every file are encrypted (XSalsa20-Poly1305, 256-bit key). File names remain legible and carry the '.encrypted' suffix." \
            S "Display the passphrase (to record it in a safe place)" \
            C "Change the passphrase") || return
        case $choice in
        S)
            msg "Encryption passphrase:\n\n$(current_passphrase)\n\nPlease keep it outside this server (password manager, printed copy). Without it, the backups cannot be recovered."
            return
            ;;
        C)
            confirm_no "Warning: the backups already uploaded were encrypted with the current passphrase. Once it is changed, this tool will no longer be able to read them unless the former passphrase is restored.\n\nDo you wish to continue?" || return
            ;;
        esac
    fi
    choice=$(menu "Encryption passphrase\n\nThe passphrase protects the files uploaded to every destination. Restoring from another server requires exactly the same passphrase." \
        G "Generate a strong random passphrase (recommended)" \
        E "Enter a passphrase (a new one, or that of an existing installation)") || return
    case $choice in
    G)
        p1=$(openssl rand -base64 33 | tr -d '\n')
        ;;
    E)
        p1=$(password "Passphrase (at least 12 characters):") || return
        p2=$(password "Confirm the passphrase:") || return
        [[ $p1 == "$p2" ]] || { msg "The two entries do not match."; return; }
        ((${#p1} >= 12)) || { msg "The passphrase is too short (at least 12 characters are required)."; return; }
        ;;
    esac
    write_crypt_remote "$p1" || { msg "The encryption settings could not be saved."; return; }
    save_config
    msg "Encryption is configured.\n\nPassphrase:\n\n$p1\n\nPlease record it now, outside this server. Without it, no restore is possible should this server be lost."
}

ui_remote_dir() {
    local v id
    v=$(input "Folder used on each destination (created if necessary).\n\nPlease note that existing backups are not moved." "$REMOTE_DIR") || return
    v=${v#/}
    v=${v%/}
    [[ -n $v ]] || { msg "The folder name may not be empty."; return; }
    REMOTE_DIR=$v
    save_config
    for id in "${DEST_IDS[@]}"; do
        has_remote "$id-crypt" &&
            rclone config update "$id-crypt" remote="$id:$REMOTE_DIR" --no-obscure >/dev/null 2>>"$LOG_FILE"
    done
}

ui_staging() {
    local items=() name stype status rest path v
    while read -r name stype status rest; do
        [[ $status == active && $stype =~ ^(dir|nfs|cifs|btrfs|cephfs)$ ]] || continue
        path=$(pvesh get "/storage/$name" --output-format json 2>/dev/null | jq -r '.path // empty')
        [[ -n $path ]] && items+=("$path/dump" "storage $name — $(df -h --output=avail "$path" 2>/dev/null | tail -n1 | tr -d ' ') free")
    done < <(pvesm status --content backup 2>/dev/null | tail -n +2)
    items+=("other" "Enter another path")
    v=$(menu "Local staging folder for vzdump\n\nEach archive is created there by vzdump, uploaded, then deleted. The folder must have enough free space for the largest backup.\n\nCurrent folder: $STAGING_DIR" "${items[@]}") || return
    [[ $v == other ]] && { v=$(input "Staging folder path:" "$STAGING_DIR") || return; }
    mkdir -p "$v" 2>/dev/null
    [[ -d $v && -w $v ]] || { msg "The folder cannot be used: $v"; return; }
    STAGING_DIR=$v
    save_config
}

ui_options() {
    local choice v
    while :; do
        choice=$(CANCEL=Back menu "Backup options" \
            M "vzdump mode: $VZDUMP_MODE" \
            C "Compression: $COMPRESS" \
            L "Upload rate limit: ${BWLIMIT:-none}" \
            V "Verification after upload: $([[ $VERIFY == 1 ]] && echo enabled || echo disabled)") || return
        case $choice in
        M)
            v=$(menu "vzdump mode" \
                snapshot "No interruption of service (recommended)" \
                suspend "Brief suspension of the guest" \
                stop "Guest stopped for the duration of the backup (highest consistency)") || continue
            VZDUMP_MODE=$v
            ;;
        C)
            v=$(menu "Compression" \
                zstd "Fast, with a good compression ratio (recommended)" \
                gzip "Widely compatible, slower" \
                lzo "Very fast, lower compression ratio" \
                0 "None") || continue
            COMPRESS=$v
            ;;
        L)
            v=$(input "rclone rate limit (e.g. 10M = 10 MiB/s; empty = none):" "$BWLIMIT") || continue
            [[ -z $v || $v =~ ^[0-9]+(\.[0-9]+)?[BKMG]?$ ]] || { msg "The format entered is not valid."; continue; }
            BWLIMIT=$v
            ;;
        V) VERIFY=$((1 - VERIFY)) ;;
        esac
        save_config
    done
}

ui_test_all() {
    local id found=0
    for id in "${DEST_IDS[@]}"; do
        has_remote "$id" || continue
        found=1
        use_dest "$id"
        ui_test
    done
    ((found)) || msg "No connection is configured."
}

ui_config() {
    local choice items i
    while :; do
        items=()
        for i in "${!DEST_IDS[@]}"; do
            items+=("$((i + 1))" "${DEST_NAMES[${DEST_IDS[$i]}]} connection: $(has_remote "${DEST_IDS[$i]}" && echo configured || echo "not configured")")
        done
        choice=$(CANCEL=Back menu "Configuration (stored in $CONF_DIR, readable by root only)" \
            "${items[@]}" \
            E "Encryption: $([[ -n $(obscured_passphrase) ]] && echo configured || echo "not configured")" \
            T "Test the connections" \
            D "Folder on the destinations: $REMOTE_DIR" \
            L "Local staging folder: $STAGING_DIR" \
            S "Backup options") || return
        case $choice in
        E) ui_setup_crypt ;;
        T) ui_test_all ;;
        D) ui_remote_dir ;;
        L) ui_staging ;;
        S) ui_options ;;
        *)
            use_dest "${DEST_IDS[choice - 1]}"
            ui_setup_remote
            ;;
        esac
    done
}

# --- Scheduling --------------------------------------------------------------

# Each schedule is one line of $CRON_FILE:
#   MIN HOUR * * DOW root <onedrivepbs> backup --to DEST (--all | ID…) >/dev/null 2>&1
SCHEDULES=()

load_schedules() {
    SCHEDULES=()
    [[ -f $CRON_FILE ]] || return 0
    mapfile -t SCHEDULES < <(grep -E '^[0-9]+ [0-9]+ \* \* [0-9*] root [^ ]+ backup ' "$CRON_FILE")
}

save_schedules() {
    if ((${#SCHEDULES[@]} == 0)); then
        rm -f "$CRON_FILE"
        return
    fi
    {
        echo "# Generated by onedrivepbs — edit through the 'Automatic scheduling' menu"
        echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        printf '%s\n' "${SCHEDULES[@]}"
    } >"$CRON_FILE"
    chmod 644 "$CRON_FILE"
}

# Splits a cron line into S_MIN, S_HOUR, S_DOW, S_DEST and S_TARGETS
# (S_TARGETS is '--all' or a list of IDs)
schedule_parse() {
    read -r S_MIN S_HOUR _ _ S_DOW _ _ _ S_TARGETS <<<"$1"
    S_TARGETS=${S_TARGETS% >/dev/null 2>&1}
    S_DEST="" # no --to: every configured destination
    if [[ $S_TARGETS == "--to "* ]]; then
        S_TARGETS=${S_TARGETS#--to }
        S_DEST=${S_TARGETS%% *}
        S_TARGETS=${S_TARGETS#* }
    fi
}

schedule_label() { # cron line -> readable label
    local when what days=(Sunday Monday Tuesday Wednesday Thursday Friday Saturday)
    schedule_parse "$1"
    if [[ $S_DOW == "*" ]]; then when="Daily"; else when="Every ${days[S_DOW]}"; fi
    if [[ $S_TARGETS == --all ]]; then what="all guests"; else what="guests $S_TARGETS"; fi
    printf '%s at %02d:%02d, %s, to %s' "$when" "$S_HOUR" "$S_MIN" "$what" "$(dest_label "$S_DEST")"
}

# Runs a schedule at once, exactly as cron would, with the progress on screen
ui_schedule_run() { # cron line
    local ids err
    schedule_parse "$1"
    err=$(set_dests "$S_DEST") || { msg "This schedule cannot be run: $err."; return; }
    set_dests "$S_DEST"
    ids=$S_TARGETS
    if [[ $ids == --all ]]; then
        ids=$(guest_list | cut -f1 | tr '\n' ' ')
        [[ -n ${ids// /} ]] || { msg "No virtual machine or container was found on this node."; return; }
    fi
    confirm "Run the following schedule now?\n\n$(schedule_label "$1")\n\nThe schedule itself is not modified." || return
    screen "Backup"
    # shellcheck disable=SC2086
    backup_guests $ids
    pause
}

ui_schedule_add() {
    local items=() id dest choice dow="*" time hour min type name status sel targets self line
    pick_dests || return
    dest=$(IFS=,; echo "${DESTS[*]}")

    choice=$(menu "Frequency of the backup" \
        D "Daily" \
        W "Weekly") || return
    if [[ $choice == W ]]; then
        dow=$(menu "Select the day of the week:" 1 Monday 2 Tuesday 3 Wednesday 4 Thursday 5 Friday 6 Saturday 0 Sunday) || return
    fi
    time=$(input "Start time (HH:MM, 24-hour clock):" "02:00") || return
    [[ $time =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || { msg "The time entered is not valid."; return; }
    hour=$((10#${BASH_REMATCH[1]}))
    min=$((10#${BASH_REMATCH[2]}))

    choice=$(menu "Guests included in this schedule" \
        A "All guests on the node, including those added later" \
        S "Selected guests only") || return
    if [[ $choice == A ]]; then
        targets="--all"
    else
        items=()
        while IFS=$'\t' read -r id type name status; do
            [[ -n $id ]] && items+=("$id" "$(printf '%-4s %s' "$type" "$name")" OFF)
        done < <(guest_list)
        ((${#items[@]})) || { msg "No virtual machine or container was found on this node."; return; }
        sel=$(checklist "Select the guests to back up (Space to select, Enter to confirm)." "${items[@]}") || return
        [[ -n $sel ]] || { msg "No guest was selected; the schedule was not created."; return; }
        targets=$(tr '\n' ' ' <<<"$sel")
        targets=${targets% }
    fi

    self=$(command -v onedrivepbs || readlink -f "${BASH_SOURCE[0]}")
    line="$min $hour * * $dow root $self backup --to $dest $targets >/dev/null 2>&1"
    load_schedules
    for id in "${SCHEDULES[@]}"; do
        [[ $id == "$line" ]] && { msg "An identical schedule already exists."; return; }
    done
    SCHEDULES+=("$line")
    save_schedules
    msg "The schedule has been saved:\n\n$(schedule_label "$line")\n\nProgress is recorded in $LOG_FILE."
}

ui_schedule() {
    local choice items i label
    while :; do
        load_schedules
        items=(A "Add a schedule")
        for i in "${!SCHEDULES[@]}"; do
            items+=("$((i + 1))" "$(schedule_label "${SCHEDULES[$i]}")")
        done
        choice=$(CANCEL=Back menu "Automatic backups (cron): ${#SCHEDULES[@]} schedule(s) defined.\n\nSelect a schedule to run it now or to remove it, or add a new one. Schedules that overlap are run one after the other." "${items[@]}") || return
        if [[ $choice == A ]]; then
            ui_schedule_add
            continue
        fi
        i=$((choice - 1))
        label=$(schedule_label "${SCHEDULES[$i]}")
        choice=$(CANCEL=Back menu "$label" \
            R "Run this schedule now" \
            D "Remove this schedule") || continue
        case $choice in
        R) ui_schedule_run "${SCHEDULES[$i]}" ;;
        D)
            confirm_no "Remove the following schedule?\n\n$label" || continue
            unset "SCHEDULES[$i]"
            SCHEDULES=("${SCHEDULES[@]}")
            save_schedules
            ;;
        esac
    done
}

ui_log() {
    local tmp
    [[ -s $LOG_FILE ]] || { msg "The log is empty."; return; }
    tmp=$(mktemp)
    tail -n 300 "$LOG_FILE" >"$tmp"
    textbox "$TITLE — $LOG_FILE (last 300 lines)" "$tmp"
    rm -f "$tmp"
}

main_menu() {
    local choice
    local id
    ensure_crypt
    if [[ -z $(dest_list) ]]; then
        msg "onedrivepbs has not been configured yet.\n\nBefore the first backup, please open the 'Configuration' menu in order to:\n\n  1. connect at least one destination (OneDrive, Google Drive);\n  2. define the encryption passphrase;\n  3. select the local staging folder for vzdump."
    fi
    for id in $(dest_list | cut -f1); do
        use_dest "$id"
        names_plain || ui_migrate_names
    done
    while :; do
        choice=$(CANCEL=Quit menu "Encrypted backup of Proxmox VE to cloud storage (node: $(hostname -s))" \
            1 "Back up virtual machines and containers" \
            2 "Restore a backup" \
            3 "Manage the stored backups" \
            4 "Automatic scheduling" \
            5 "Configuration" \
            6 "Log") || break
        case $choice in
        1) ui_backup ;;
        2) ui_restore ;;
        3) ui_manage ;;
        4) ui_schedule ;;
        5) ui_config ;;
        6) ui_log ;;
        esac
    done
    clear
}

# --- Command line ------------------------------------------------------------

usage() {
    cat <<EOF
onedrivepbs $VERSION — encrypted Proxmox VE backup to OneDrive and Google Drive

Usage:
  onedrivepbs                               open the menus
  onedrivepbs backup [--to DEST] --all      back up every guest on the node
  onedrivepbs backup [--to DEST] ID [ID…]   back up the given guests
  onedrivepbs list [--to DEST]              list the stored backups
  onedrivepbs prune [--to DEST]             apply retention
  onedrivepbs --version | --help

DEST is one or more destinations separated by commas: ${DEST_IDS[*]}.
Without --to, every configured destination is used.

Restore and configuration are done through the menus.
EOF
}

main() {
    case ${1:-} in
    -h | --help) usage; exit 0 ;;
    --version) echo "$VERSION"; exit 0 ;;
    esac
    ((EUID == 0)) || die "onedrivepbs must be run as root."
    check_deps
    load_config

    local ids line cmd=${1:-} err d
    if [[ -n $cmd ]]; then
        shift
        if [[ ${1:-} == --to ]]; then
            [[ -n ${2:-} ]] || die "--to requires a destination."
            err=$(set_dests "$2") || die "$err."
            set_dests "$2"
            shift 2
        else
            err=$(set_dests "") || die "$err."
            set_dests ""
        fi
    fi
    case $cmd in
    "")
        [[ -t 0 && -t 1 ]] || die "the menus need a terminal; see --help."
        main_menu
        ;;
    backup)
        (($#)) || die "specify --all or at least one ID."
        # a run started while another one is in progress waits for its turn
        LOCK_WAIT=43200
        if [[ $1 == --all ]]; then
            ids=$(guest_list | cut -f1 | tr '\n' ' ')
            [[ -n ${ids// /} ]] || die "no guests on this node."
        else
            ids="$*"
        fi
        # shellcheck disable=SC2086
        backup_guests $ids
        ;;
    list)
        for d in "${DESTS[@]}"; do
            use_dest "$d"
            ((${#DESTS[@]} > 1)) && echo "$DEST_NAME:"
            while IFS= read -r line; do
                backup_label "$line"
                echo
            done < <(remote_list)
        done
        ;;
    prune)
        acquire_lock || exit 1
        for d in "${DESTS[@]}"; do
            use_dest "$d"
            prune_remote
        done
        ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
}

main "$@"
